/*
CVL (non-contractual purchases and value)

In a non-contractual business customers never announce that they have left; they just stop buying.
The models here separate “gone” from “slow” by assuming two hidden processes per customer:

1. Buying while alive: purchases arrive as a Poisson process with rate λn (on average λn purchases per time
unit, at random moments);

2. Dying: the customer becomes permanently inactive at an unobserved moment — after each purchase with
probability pn (BG/NBD), after an exponential lifetime with rate µn (Pareto/NBD), or after a lifetime
with any survival hazard

Customers differ: λ ∼ Gamma(r, α), p ∼ Beta( a, b), µ ∼ Gamma(s, β). For these models the likelihood
depends on a customer’s purchase history only through frequency x, recency t x and age T (Layout B). The
long silence between t x and T is the evidence about death: the longer it is relative to how often the customer
used to buy, the more likely they are gone.
*/

// V.1 BG/NBD likelihood =======================================================================================================================
//@laplace
//@brief Beta-Geometric / Negative Binomial Log Likelihood
//@param array[] int x[n] : The number of repeat purchases (first purchase excluded).
//@param vector t_x[n]    : Recency: Time of the last repeat purchase, measured from the first purchase.
//@param vector T[n]      : Time from the first purchase to the end of the data.
//@param real r, alpha    : Purchase rates while alive follow lambda ~ Gamma(r, alpha), with mean rate r / alpha.
//@param real a, b        : Dropout probabilities after each purchase follow pn ~ Beta(a, b), with mean a / (a + b).
//@math
// \lambda_n \sim \mathrm{Gamma}(r, \alpha), \quad p_n \sim \mathrm{Beta}(a, b) \\
// A_{0,n} = \log\Gamma(r + x_n) - \log\Gamma(r) + r\log\alpha - \log B(a, b) \\
// A_{1,n} = \log B(a,\, b + x_n) - (r + x_n)\log(\alpha + T_n) \\
// A_{2,n} = \log B(a + 1,\, b + x_n - 1) - (r + x_n)\log(\alpha + t_{x,n}) \\
// \ell_n = A_{0,n} + A_{1,n} \ \text{if } x_n = 0, \qquad \ell_n = A_{0,n} + \log\left(e^{A_{1,n}} + e^{A_{2,n}}\right) \ \text{if } x_n > 0
vector bgnbd_loglik(array[] int x, data vector t_x, data vector T, real r, real alpha, real a, real b){
    int N = num_elements(x);
    
    matrix[3, N] A;
    vector[N] ln;

    for(n in 1:N){
        A[1, n] = lgamma(r + x[n]) - lgamma(r) + r * log(alpha) - lbeta(a, b);
        A[2, n] = lbeta(a, b + x[n]) - (r + x[n])  * log(alpha + T[n]);

        // Build the Log Likelihood from a peace function 
        if(x[n] == 0){
            ln[n] = A[1, n] + A[2, n];
        
        }else{
            A[3, n] = lbeta(a + 1, b + x[n] - 1) - (r + x[n]) * log(alpha + t_x[n]); 
            ln[n] = A[1, n] + log(exp(A[2, n]) + exp(A[3, n]));
        }
    }
    return ln;
}
vector bgnbd_loglik(array[] int x, data vector t_x, data vector T, real r, vector alpha, real a, real b){
    int N = num_elements(x);
    
    matrix[3, N] A;
    vector[N] ln;

    for(n in 1:N){
        A[1, n] = lgamma(r + x[n]) - lgamma(r) + r * log(alpha[n]) - lbeta(a, b);
        A[2, n] = lbeta(a, b + x[n]) - (r + x[n])  * log(alpha[n] + T[n]);

        // Build the Log Likelihood from a peace function 
        if(x[n] == 0){
            ln[n] = A[1, n] + A[2, n];
        
        }else{
            A[3, n] = lbeta(a + 1, b + x[n] - 1) - (r + x[n]) * log(alpha[n] + t_x[n]); 
            ln[n] = A[1, n] + log(exp(A[2, n]) + exp(A[3, n]));
        }
    }
    return ln;
}
vector bgnbd_loglik(array[] int x, data vector t_x, data vector T, real r, real alpha, vector a, vector b){
    int N = num_elements(x);
    
    matrix[3, N] A;
    vector[N] ln;

    for(n in 1:N){
        A[1, n] = lgamma(r + x[n]) - lgamma(r) + r * log(alpha) - lbeta(a[n], b[n]);
        A[2, n] = lbeta(a[n], b[n] + x[n]) - (r + x[n])  * log(alpha + T[n]);

        // Build the Log Likelihood from a peace function 
        if(x[n] == 0){
            ln[n] = A[1, n] + A[2, n];
        
        }else{
            A[3, n] = lbeta(a[n] + 1, b[n] + x[n] - 1) - (r + x[n]) * log(alpha + t_x[n]); 
            ln[n] = A[1, n] + log(exp(A[2, n]) + exp(A[3, n]));
        }
    }
    return ln;
}
vector bgnbd_loglik(array[] int x, data vector t_x, data vector T, real r, vector alpha, vector a, vector b){
    int N = num_elements(x);
    
    matrix[3, N] A;
    vector[N] ln;

    for(n in 1:N){
        A[1, n] = lgamma(r + x[n]) - lgamma(r) + r * log(alpha[n]) - lbeta(a[n], b[n]);
        A[2, n] = lbeta(a[n], b[n] + x[n]) - (r + x[n])  * log(alpha[n] + T[n]);

        // Build the Log Likelihood from a peace function 
        if(x[n] == 0){
            ln[n] = A[1, n] + A[2, n];
        
        }else{
            A[3, n] = lbeta(a[n] + 1, b[n] + x[n] - 1) - (r + x[n]) * log(alpha[n] + t_x[n]); 
            ln[n] = A[1, n] + log(exp(A[2, n]) + exp(A[3, n]));
        }
    }
    return ln;
}

//@laplace 
//@brief Beta-Geometric / Negative Binomial Log Probability Mass Function 
//@param array[] int x[n] : The number of repeat purchases (first purchase excluded).
//@param vector t_x[n]    : Recency: Time of the last repeat purchase, measured from the first purchase.
//@param vector T[n]      : Time from the first purchase to the end of the data.
//@param real r, alpha    : Purchase rates while alive follow lambda ~ Gamma(r, alpha), with mean rate r / alpha.
//@param real a, b        : Dropout probabilities after each purchase follow pn ~ Beta(a, b), with mean a / (a + b).
//@math
// L_n = \frac{B(a, b + x_n)}{B(a, b)}\,\frac{\Gamma(r + x_n)\,\alpha^r}{\Gamma(r)\,(\alpha + T_n)^{r + x_n}} + \mathbb{1}\{x_n > 0\}\,\frac{B(a + 1, b + x_n - 1)}{B(a, b)}\,\frac{\Gamma(r + x_n)\,\alpha^r}{\Gamma(r)\,(\alpha + t_{x,n})^{r + x_n}} \\
// \log L = \sum_{n=1}^{N} \log L_n
real bgnbd_lpmf(array[] int x, data vector t_x, data vector T, real r, real alpha, real a, real b){
    return sum(bgnbd_loglik(x, t_x, T, r, alpha, a, b));
}
real bgnbd_lpmf(array[] int x, data vector t_x, data vector T, real r, vector alpha, real a, real b){
    return sum(bgnbd_loglik(x, t_x, T, r, alpha, a, b));
}
real bgnbd_lpmf(array[] int x, data vector t_x, data vector T, real r, real alpha, vector a, vector b){
    return sum(bgnbd_loglik(x, t_x, T, r, alpha, a, b));
}
real bgnbd_lpmf(array[] int x, data vector t_x, data vector T, real r, vector alpha, vector a, vector b){
    return sum(bgnbd_loglik(x, t_x, T, r, alpha, a, b));
}

//@laplace
//@brief Beta-Geometric / Negative Binomial Weighted Log Probability Mass Function 
//@param array[] int x[n] : The number of repeat purchases (first purchase excluded).
//@param vector t_x[n]    : Recency: Time of the last repeat purchase, measured from the first purchase.
//@param vector T[n]      : Time from the first purchase to the end of the data.
//@param real r, alpha    : Purchase rates while alive follow lambda ~ Gamma(r, alpha), with mean rate r / alpha.
//@param real a, b        : Dropout probabilities after each purchase follow pn ~ Beta(a, b), with mean a / (a + b).
//@param vector w         : Rows u are the unique (x, t_x, T) combinations and w_u is how many customers share each one.
//@math
// \ell_u = \log L_u \ \text{for each unique } (x_u, t_{x,u}, T_u) \\
// \log L = \sum_{u=1}^{U} w_u\,\ell_u, \quad w_u = \text{number of customers with that history}
real bgnbd_weighted_lpmf(array[] int x, data vector t_x, data vector T, data vector w, real r, real alpha, real a, real b){
    return sum(bgnbd_loglik(x, t_x, T, r, alpha, a, b) .* w);
}
real bgnbd_weighted_lpmf(array[] int x, data vector t_x, data vector T, data vector w, real r, vector alpha, real a, real b){
    return sum(bgnbd_loglik(x, t_x, T, r, alpha, a, b) .* w);
}
real bgnbd_weighted_lpmf(array[] int x, data vector t_x, data vector T, data vector w, real r, real alpha, vector a, vector b){
    return sum(bgnbd_loglik(x, t_x, T, r, alpha, a, b) .* w);
}
real bgnbd_weighted_lpmf(array[] int x, data vector t_x, data vector T, data vector w, real r, vector alpha, vector a, vector b){
    return sum(bgnbd_loglik(x, t_x, T, r, alpha, a, b) .* w);
}

// V.2 Probability a customer is alive ------------------------------------------------------------------------------------------------------------
// For each customer, the probability that they are still active at the end of the observation window
//@laplace 
//@brief Beta-Geometric / Negative Binomial: Probability a customer is alive
//@param array[] int x    : Repeat purchases
//@param vector t_x       : Recency: Time of the last repeat purchase, measured from the first purchase.
//@param vector T         : Time from the first purchase to the end of the data.
//@param real r, alpha    : Purchase rates while alive follow lambda ~ Gamma(r, alpha), with mean rate r / alpha.
//@param real a, b        : Dropout probabilities after each purchase follow pn ~ Beta(a, b), with mean a / (a + b).
//@return vector Returns the log probability that each customer is still active at T_n 
//@math
// \kappa_n = \log a - \log(b + x_n - 1) + (r + x_n)\left[\log(\alpha + T_n) - \log(\alpha + t_{x,n})\right] \\
// \log P_n(\text{alive}) = 0 \ \text{if } x_n = 0, \qquad \log P_n(\text{alive}) = -\log\left(1 + e^{\kappa_n}\right) \ \text{if } x_n > 0 \\
// P_n(\text{alive}) = \frac{1}{1 + \mathbb{1}\{x_n > 0\}\,\frac{a}{b + x_n - 1}\left(\frac{\alpha + T_n}{\alpha + t_{x,n}}\right)^{r + x_n}}
vector bgnbd_log_p_alive(array[] int x, vector t_x, vector T, real r, real alpha, real a, real b){
    int N = num_elements(T);
    vector[N] k;
    vector[N] p_alive;

    for(n in 1:N){
        // Initialize empty vector
        p_alive[n] = 0;
        k[n]       = 0;
        k[n] = log(a) - log(b + x[n] - 1) + (r + x[n]) * (log(alpha + T[n]) - log(alpha + t_x[n]));

        // Calculate Log(P(alive)) from piece function
        if(x[n] == 0){
            p_alive[n] = 0;
        
        }else{
            p_alive[n] = -log1p_exp(k[n]);
        }
    }
    // Returns the log probability that each customer is still active at T_n 
    return p_alive;
}
vector bgnbd_log_p_alive(array[] int x, vector t_x, vector T, real r, vector alpha, real a, real b){
    int N = num_elements(T);
    vector[N] k;
    vector[N] p_alive;

    for(n in 1:N){
        // Initialize empty vector
        p_alive[n] = 0;
        k[n]       = 0;
        k[n] = log(a) - log(b + x[n] - 1) + (r + x[n]) * (log(alpha[n] + T[n]) - log(alpha[n] + t_x[n]));

        // Calculate Log(P(alive)) from piece function
        if(x[n] == 0){
            p_alive[n] = 0;
        
        }else{
            p_alive[n] = -log1p_exp(k[n]);
        }
    }
    // Returns the log probability that each customer is still active at T_n 
    return p_alive;
}
vector bgnbd_log_p_alive(array[] int x, vector t_x, vector T, real r, real alpha, vector a, vector b){
    int N = num_elements(T);
    vector[N] k;
    vector[N] p_alive;

    for(n in 1:N){
        // Initialize empty vector
        p_alive[n] = 0;
        k[n]       = 0;
        k[n] = log(a[n]) - log(b[n] + x[n] - 1) + (r + x[n]) * (log(alpha + T[n]) - log(alpha + t_x[n]));

        // Calculate Log(P(alive)) from piece function
        if(x[n] == 0){
            p_alive[n] = 0;
        
        }else{
            p_alive[n] = -log1p_exp(k[n]);
        }
    }
    // Returns the log probability that each customer is still active at T_n 
    return p_alive;
}
vector bgnbd_log_p_alive(array[] int x, vector t_x, vector T, real r, vector alpha, vector a, vector b){
    int N = num_elements(T);
    vector[N] k;
    vector[N] p_alive;

    for(n in 1:N){
        // Initialize empty vector
        p_alive[n] = 0;
        k[n]       = 0;
        k[n] = log(a[n]) - log(b[n] + x[n] - 1) + (r + x[n]) * (log(alpha[n] + T[n]) - log(alpha[n] + t_x[n]));

        // Calculate Log(P(alive)) from piece function
        if(x[n] == 0){
            p_alive[n] = 0;
        
        }else{
            p_alive[n] = -log1p_exp(k[n]);
        }
    }
    // Returns the log probability that each customer is still active at T_n 
    return p_alive;
}

// V.3 Expected purchases of a new customer -------------------------------------------------------------------------------------------------------
// Returns a count. E[ X (52)] = 1.4 means a newly acquired customer is expected to make 1.4 repeat purchases in their first year.
//@laplace 
//@brief Beta-Geometric / Negative Binomial : Expected purchases of a new customer for specified time period 
//@param real t         : Forecast length, in the same time unit as T.
//@param real r, alpha  : Purchase rates while alive follow lambda ~ Gamma(r, alpha), with mean rate r / alpha.
//@param real a, b      : Dropout probabilities after each purchase follow pn ~ Beta(a, b), with mean a / (a + b).
//@return real Expected repeat purchases in 0, t for a randomly chosen new customer.
//@math
// \mathbb{E}[X(t)] = \frac{a + b - 1}{a - 1}\left[1 - \left(\frac{\alpha}{\alpha + t}\right)^{r} {}_2F_1\left(r,\ b;\ a + b - 1;\ \frac{t}{\alpha + t}\right)\right], \quad a > 1
real bgnbd_expected_uncond(real t, real r, real alpha, real a, real b){
    // It returns the expected repeat purchases in 0, t for a randomly chosen new customer.
    return ((a + b - 1) / (a - 1)) * (1 - pow(alpha / (alpha + t), r) * hypergeometric_2F1(r, b, a +  b -1, t / (alpha + t))); 
}
vector bgnbd_expected_uncond(vector t, real r, real alpha, real a, real b){
    // It returns the expected repeat purchases in 0, t for a randomly chosen new customer.
    int N = num_elements(t);
    vector[N] expect;

    for(n in 1:N){
        expect[n] = 0;
        expect[n] = ((a + b - 1) / (a - 1)) * (1 - pow(alpha / (alpha + t[n]), r) * hypergeometric_2F1(r, b, a +  b -1, t[n] / (alpha + t[n]))); 
    }
    return expect;
}

// V.4 Expected future purchases of an existing customer ------------------------------------------------------------------------------------------
// Private helper all parameters per customer, P(alive) passed in on the log scale.
vector cst_bgnbd_expected_cond(real t, array[] int x, vector T, real r, vector alpha, vector a, vector b, vector log_p_alive){
    int N = num_elements(T);
    vector[N] expected;

    for(n in 1:N){
        real zn = t / (alpha[n] + T[n] + t);
        expected[n] = exp(log_p_alive[n])
                    * ((a[n] + b[n] + x[n] - 1) / (a[n] - 1))
                    * (1 - pow((alpha[n] + T[n]) / (alpha[n] + T[n] + t), r + x[n])
                         * hypergeometric_2F1(r + x[n], b[n] + x[n], a[n] + b[n] + x[n] - 1, zn));
    }
    return expected;
}

//@laplace 
//@brief Beta-Geometric / Negative Binomial : Expected future purchases of an existing customer in (T_n, T_n + t]
//@param real t           : Forecast length, in the same time unit as T. A vector t returns one column per horizon.
//@param array[] int x    : Repeat purchases
//@param vector t_x       : Recency: Time of the last repeat purchase, measured from the first purchase.
//@param vector T         : Time from the first purchase to the end of the data.
//@param real r, alpha    : Purchase rates while alive follow lambda ~ Gamma(r, alpha), with mean rate r / alpha. alpha may be per-customer (vector).
//@param real a, b        : Dropout probabilities after each purchase follow pn ~ Beta(a, b), with mean a / (a + b). a, b may be per-customer (vector).
//@return vector[N] expected purchases per customer for real t; matrix[N, K] with column k = horizon t[k] for vector t.
//@math
// z_n = \frac{t}{\alpha + T_n + t} \\
// \mathbb{E}[Y_n(t)] = P_n(\text{alive})\,\frac{a + b + x_n - 1}{a - 1}\left[1 - \left(\frac{\alpha + T_n}{\alpha + T_n + t}\right)^{r + x_n} {}_2F_1\left(r + x_n,\ b + x_n;\ a + b + x_n - 1;\ z_n\right)\right], \quad a > 1 \\
// P_n(\text{alive}) = \exp\left(\texttt{bgnbd\_log\_p\_alive}\right) \ \text{(V.2)} \\
// \alpha \to \alpha_n,\ a \to a_n,\ b \to b_n \ \text{for the per-customer overloads}
vector bgnbd_expected_cond(real t, array[] int x, vector t_x, vector T, real r, real alpha, real a, real b){
    int N = num_elements(T);
    return cst_bgnbd_expected_cond(t, x, T, r, rep_vector(alpha, N), rep_vector(a, N), rep_vector(b, N), bgnbd_log_p_alive(x, t_x, T, r, alpha, a, b));
}
// Covariates on the purchase rate: alpha per customer
vector bgnbd_expected_cond(real t, array[] int x, vector t_x, vector T, real r, vector alpha, real a, real b){
    int N = num_elements(T);
    return cst_bgnbd_expected_cond(t, x, T, r, alpha, rep_vector(a, N), rep_vector(b, N), bgnbd_log_p_alive(x, t_x, T, r, alpha, a, b));
}
// Covariates on dropout: a, b per customer
vector bgnbd_expected_cond(real t, array[] int x, vector t_x, vector T, real r, real alpha, vector a, vector b){
    int N = num_elements(T);
    return cst_bgnbd_expected_cond(t, x, T, r, rep_vector(alpha, N), a, b, bgnbd_log_p_alive(x, t_x, T, r, alpha, a, b));
}
// Covariates on both: alpha, a, b per customer
vector bgnbd_expected_cond(real t, array[] int x, vector t_x, vector T, real r, vector alpha, vector a, vector b){
    return cst_bgnbd_expected_cond(t, x, T, r, alpha, a, b, bgnbd_log_p_alive(x, t_x, T, r, alpha, a, b));
}

// Several horizons at once (used by V.11): column k = E[Y_n(t[k])]. P(alive) is computed once.
matrix bgnbd_expected_cond(vector t, array[] int x, vector t_x, vector T, real r, real alpha, real a, real b){
    int N = num_elements(T);
    int K = num_elements(t);
    matrix[N, K] E;
    vector[N] lp = bgnbd_log_p_alive(x, t_x, T, r, alpha, a, b);
    for(k in 1:K)
        E[, k] = cst_bgnbd_expected_cond(t[k], x, T, r, rep_vector(alpha, N), rep_vector(a, N), rep_vector(b, N), lp);
    return E;
}
matrix bgnbd_expected_cond(vector t, array[] int x, vector t_x, vector T, real r, vector alpha, real a, real b){
    int N = num_elements(T);
    int K = num_elements(t);
    matrix[N, K] E;
    vector[N] lp = bgnbd_log_p_alive(x, t_x, T, r, alpha, a, b);
    for(k in 1:K)
        E[, k] = cst_bgnbd_expected_cond(t[k], x, T, r, alpha, rep_vector(a, N), rep_vector(b, N), lp);
    return E;
}
matrix bgnbd_expected_cond(vector t, array[] int x, vector t_x, vector T, real r, real alpha, vector a, vector b){
    int N = num_elements(T);
    int K = num_elements(t);
    matrix[N, K] E;
    vector[N] lp = bgnbd_log_p_alive(x, t_x, T, r, alpha, a, b);
    for(k in 1:K)
        E[, k] = cst_bgnbd_expected_cond(t[k], x, T, r, rep_vector(alpha, N), a, b, lp);
    return E;
}
matrix bgnbd_expected_cond(vector t, array[] int x, vector t_x, vector T, real r, vector alpha, vector a, vector b){
    int N = num_elements(T);
    int K = num_elements(t);
    matrix[N, K] E;
    vector[N] lp = bgnbd_log_p_alive(x, t_x, T, r, alpha, a, b);
    for(k in 1:K)
        E[, k] = cst_bgnbd_expected_cond(t[k], x, T, r, alpha, a, b, lp);
    return E;
}

// V5 Simulators -------------------------------------------------------------------------------------------------------------------------------------
//@laplace
//@brief Beta-Geometric / Negative Binomial Individual Random Number Generator
//@param real T         : Observation length (age), in the model's time unit.
//@param real lambda, p : One customer's purchase rate while alive and their dropout probability after each repeat purchase.
//@math
// \tau_0 = 0, \quad \tau_j = \tau_{j-1} + E_j, \quad E_j \sim \mathrm{Exponential}(\lambda) \\
// \text{for } j = 1, 2, \dots: \ \text{if } \tau_j > T \text{ stop; else } x = j,\ t_x = \tau_j, \text{ then stop with probability } p \\
// \text{returns } (x, t_x), \quad 0 \le t_x \le T, \quad t_x = 0 \iff x = 0
vector bgnbd_indiv_rng(real T, real lambda, real p){
    // Initialize variables 
    real tau = 0;
    real j   = 0;
    real tx  = 0;
    real x   = 0;

    while(1){
        real E = exponential_rng(lambda);
        tau   += E;
        
        if(tau > T){
            break;
        }
        x  = j;
        tx = tau;

        if (bernoulli_rng(p) == 1)
            break;
    }
    return to_vector([x, tx]);
}
matrix bgnbd_rng(vector lambda, vector p, vector T){
    int N = num_elements(lambda);
    matrix[N, 2] result;

    for (n in 1:N) {
        real tau = 0;
        real x = 0;
        real tx = 0;

        while (1) {
            real E = exponential_rng(lambda[n]);
            tau += E;

            if (tau > T[n])
                break;

            x += 1;
            tx = tau;

            if (bernoulli_rng(p[n]) == 1)
                break;
        }
        result[n, 1] = x;
        result[n, 2] = tx;
    }
    return result;
}

//@laplace
//@brief Beta-Geometric / Negative Binomial Population Random Number Generator
//@param T         : Observation length (age), in the model's time unit.
//@param r, alpha, a, b : Population parameters, with lambda ~ Gamma(r, alpha) [rate alpha] p ~ Beta(a, b).
//@return vector[2] (x, t_x) for one randomly drawn customer.
//@math
// \lambda \sim \mathrm{Gamma}(r, \alpha), \quad p \sim \mathrm{Beta}(a, b) \\
// (x, t_x) = \texttt{bgnbd\_indiv\_rng}(T, \lambda, p) \\
// \text{vector } T: \ \text{row } n = (x_n, t_{x,n}) \text{ simulated at age } T_n
vector bgnbd_rng(real T, real r, real alpha, real a, real b) {
    real lambda = gamma_rng(r, alpha);
    real p      = beta_rng(a, b);

    return bgnbd_indiv_rng(T, lambda, p);
}
matrix bgnbd_rng(vector T, real r, real alpha, real a, real b) {
    int N = num_elements(T);
    matrix[N, 2] L;

    for (n in 1:N) {
        real lambda = gamma_rng(r, alpha);
        real p      = beta_rng(a, b);
        vector[2] z = bgnbd_indiv_rng(T[n], lambda, p);

        L[n, 1] = z[1];
        L[n, 2] = z[2];
    }

    return L;
}
matrix bgnbd_rng(vector T, real r, vector alpha, real a, real b) {
    int N = num_elements(T);
    matrix[N, 2] L;

    for (n in 1:N) {
        real lambda = gamma_rng(r, alpha[n]);
        real p      = beta_rng(a, b);

        vector[2] z = bgnbd_indiv_rng(T[n], lambda, p);
        L[n, 1] = z[1];
        L[n, 2] = z[2];
    }
    return L;
}
matrix bgnbd_rng(vector T, real r, real alpha, vector a, vector b) {
    int N = num_elements(T);
    matrix[N, 2] L;

    for (n in 1:N) {
        real lambda = gamma_rng(r, alpha);
        real p      = beta_rng(a[n], b[n]);

        vector[2] z = bgnbd_indiv_rng(T[n], lambda, p);
        L[n, 1] = z[1];
        L[n, 2] = z[2];
    }
    return L;
}
matrix bgnbd_rng(vector T, real r, vector alpha, vector a, vector b){
    int N = num_elements(T);
    matrix[N, 2] L;

    for (n in 1:N) {
        real lambda = gamma_rng(r, alpha[n]);
        real p      = beta_rng(a[n], b[n]);

        vector[2] z = bgnbd_indiv_rng(T[n], lambda, p);
        L[n, 1] = z[1];
        L[n, 2] = z[2];
    }
    return L;
}

// V.6 Individual-level BG/NBD (hierarchical, with covariates) ----------------------------------------------------------------------------------
//@laplace
//@brief Beta-Geometric / Negative Binomial Individual Log Likelihood with covariates
//@param array[] int x    : Repeat purchases
//@param vector t_x       : Recency: Time of the last repeat purchase, measured from the first purchase.
//@param vector T         : Time from the first purchase to the end of the data.
//@param vector lambda    : Customer n s purchase rate while alive
//@param vector p         : Customer n s dropout probability after each repeat purchase
vector bgnbd_indiv_loglik(array[] int x, vector t_x, vector T, vector lambda, vector p){
    int N = num_elements(lambda);
    vector[N] Ln;

    for(n in 1:N){
        Ln[n] = 0;
        
        if(x[n] == 0){
            Ln[n] = -lambda[n] * T[n];
        
        }else{
            Ln[n] = x[n] * log(lambda[n]) + (x[n] - 1)
                         * log(1 - p[n]) 
                         + log(exp(log(1 - p[n]) - lambda[n] * T[n]) + exp(log(1 - p[n]) - lambda[n] * t_x[n]));
        }
    }
    return Ln;
}

// V.7 Pareto/NBD (individual level) and discounted expected transactions -----------------------------------------------------------------------
//@laplace 
//@brief Pareto-Negative Binomial Log Likelihood 
//@param array[] int x : Repeat purchases
//@param vector t_x    : Recency: Time of the last repeat purchase, measured from the first purchase.
//@param vector T      : Time from the first purchase to the end of the data.
//@param vector lambda : Purchase rate while alive.
//@param vector mu     : Constant churn hazard that applies at any moment, not only after purchases.
//@math
// \ell_n = x_n\log\lambda_n - \log(\lambda_n + \mu_n) + \log\left(e^{\log\mu_n - (\lambda_n + \mu_n)t_{x,n}} + e^{\log\lambda_n - (\lambda_n + \mu_n)T_n}\right)
vector pnbd_indiv_loglik(array[] int x, vector t_x, vector T, vector lambda, vector mu){
    int N = num_elements(lambda);
    vector[N] ln;
    for(n in 1:N){
        ln[n] = 0;
        ln[n] = x[n] * log(lambda[n]) - log(lambda[n] - mu[n]) 
                     + log(exp(log(mu[n] - (lambda[n] + mu[n]) * t_x[n])) 
                     + exp(log(lambda[n] - (lambda[n] + mu[n]) * T[n])));
    }
    return ln;
}
vector pnbd_indiv_loglik(array[] int x, vector t_x, vector T, real lambda, vector mu){
    int N = num_elements(t_x);
    vector[N] ln;
    for(n in 1:N){
        ln[n] = 0;
        ln[n] = x[n] * log(lambda) - log(lambda - mu[n]) 
                     + log(exp(log(mu[n] - (lambda + mu[n]) * t_x[n])) 
                     + exp(log(lambda - (lambda + mu[n]) * T[n])));
    }
    return ln;
}
vector pnbd_indiv_loglik(array[] int x, vector t_x, vector T, real lambda, real mu){
    int N = num_elements(t_x);
    vector[N] ln;
    for(n in 1:N){
        ln[n] = 0;
        ln[n] = x[n] * log(lambda) - log(lambda - mu) 
                     + log(exp(log(mu - (lambda + mu) * t_x[n])) 
                     + exp(log(lambda - (lambda + mu) * T[n])));
    }
    return ln;
}
vector pnbd_indiv_loglik(array[] int x, vector t_x, vector T, vector lambda, real mu){
    int N = num_elements(t_x);
    vector[N] ln;
    for(n in 1:N){
        ln[n] = 0;
        ln[n] = x[n] * log(lambda[n]) - log(lambda[n] - mu) 
                     + log(exp(log(mu - (lambda[n] + mu) * t_x[n])) 
                     + exp(log(lambda[n] - (lambda[n] + mu) * T[n])));
    }
    return ln;
}

//@laplace 
//@brief Pareto-Negative Binomial Individual Log Pointwise Mass function
//@param array[] int x : Repeat purchases
//@param vector t_x    : Recency: Time of the last repeat purchase, measured from the first purchase.
//@param vector T      :  Time from the first purchase to the end of the data.
//@param vector lambda : Purchase rate while alive.
//@param vector mu     : Constant churn hazard that applies at any moment, not only after purchases.
//@math
// \log L = \sum_{n=1}^{N}\ell_n, \quad \ell_n \text{ as in pnbd\_indiv\_loglik}
real pnbd_indiv_lpmf(array[] int x, vector t_x, vector T, vector lambda, vector mu){
    return sum( pnbd_indiv_loglik(x, t_x, T, lambda, mu));
}
real pnbd_indiv_lpmf(array[] int x, vector t_x, vector T, real lambda, real mu){
    return sum( pnbd_indiv_loglik(x, t_x, T, lambda, mu));
}
real pnbd_indiv_lpmf(array[] int x, vector t_x, vector T, vector lambda, real mu){
    return sum( pnbd_indiv_loglik(x, t_x, T, lambda, mu));
}
real pnbd_indiv_lpmf(array[] int x, vector t_x, vector T, real lambda, vector mu){
    return sum( pnbd_indiv_loglik(x, t_x, T, lambda, mu));
}

//@laplace
//@brief Pareto-Negative Binomial Log Probability of a customer being alive
//@param array[] int x : Repeat purchases
//@param vector t_x    : Recency: Time of the last repeat purchase, measured from the first purchase.
//@param vector T      : Time from the first purchase to the end of the data.
//@param vector lambda : Purchase rate while alive.
//@param vector mu     : Constant churn hazard that applies at any moment, not only after purchases.
//@math
// \log P_n(\text{alive}) = \log(\lambda_n + \mu_n) - (\lambda_n + \mu_n)T_n - \log\left(e^{\log\mu_n - (\lambda_n + \mu_n)t_{x,n}} + e^{\log\lambda_n - (\lambda_n + \mu_n)T_n}\right) \\
// P_n(\text{alive}) = \frac{1}{1 + \frac{\mu_n}{\lambda_n + \mu_n}\left(e^{\Delta_n} - 1\right)}, \quad \Delta_n = (\lambda_n + \mu_n)(T_n - t_{x,n})
vector pnbd_log_p_alive(array[] int x, vector t_x, vector T, vector lambda, vector mu){
    int N = num_elements(lambda);
    vector[N] p_alive;
    vector[N] delta;

    for(n in 1:N){
        delta[n]   = (lambda[n] + mu[n]) * (T[n] - t_x[n]);
        p_alive[n] = 1 / (1 + (mu[n] / (lambda[n] + mu[n])) * log1m_exp(-delta[n])); 
    }
    return p_alive;
}
vector pnbd_log_p_alive(array[] int x, vector t_x, vector T, real lambda, real mu){
    int N = num_elements(t_x);
    vector[N] p_alive;
    vector[N] delta;

    for(n in 1:N){
        delta[n]   = (lambda + mu) * (T[n] - t_x[n]);
        p_alive[n] = 1 / (1 + (mu / (lambda + mu)) * log1m_exp(-delta[n])); 
    }
    return p_alive;
}
vector pnbd_log_p_alive(array[] int x, vector t_x, vector T, vector lambda, real mu){
    int N = num_elements(t_x);
    vector[N] p_alive;
    vector[N] delta;

    for(n in 1:N){
        delta[n]   = (lambda[n] + mu) * (T[n] - t_x[n]);
        p_alive[n] = 1 / (1 + (mu / (lambda[n] + mu)) * log1m_exp(-delta[n])); 
    }
    return p_alive;
}
vector pnbd_log_p_alive(array[] int x, vector t_x, vector T, real lambda, vector mu){
    int N = num_elements(t_x);
    vector[N] p_alive;
    vector[N] delta;

    for(n in 1:N){
        delta[n]   = (lambda + mu[n]) * (T[n] - t_x[n]);
        p_alive[n] = 1 / (1 + (mu[n] / (lambda + mu[n])) * log1m_exp(-delta[n])); 
    }
    return p_alive;
}

//@laplace
//@brief Pareto-Negative Binomial Discounted Expected Transactions
//@param vector log_p_alive : Log Probability of a customer being alive
//@param vector lambda      : Purchase rate while alive.
//@param real delta         : Continuous discount rate per time unit.
//@param vector mu          : Constant churn hazard that applies at any moment, not only after purchases.
//@math
// \operatorname{DET}_n = P_n(\text{alive})\int_0^\infty \lambda_n e^{-(\mu_n + \delta)s}\,ds = P_n(\text{alive})\,\frac{\lambda_n}{\mu_n + \delta}
vector pnbd_det(vector log_p_alive, vector lambda, vector mu, real delta){
    return log_p_alive .* (lambda ./ mu + delta);
}


//@laplace 
//@brief Pareto-Negative Binomial Expected purchases
//@param vector log_p_alive : Log Probability of a customer being alive
//@param vector lambda      : Purchase rate while alive.
//@param vector mu          : Constant churn hazard that applies at any moment, not only after purchases.
//@param real t             : Future Event Horizon
//@math
// \mathbb{E}[Y_n(t)] = P_n(\text{alive})\,\frac{\lambda_n}{\mu_n}\left(1 - e^{-\mu_n t}\right), \quad \mu_n \to 0: \ \mathbb{E}[Y_n(t)] \to P_n(\text{alive})\,\lambda_n t
vector pnbd_expected_cond(real t, vector log_p_alive, vector lambda, vector mu){
    return log_p_alive .* (lambda ./ mu) .* (1 - exp(-mu * t));
}

//@laplace
//@brief Pareto-Negative Binomial Individual Random Number Generator
//@param real T      : Time from the first purchase to the end of the data.
//@param real lambda : Purchase rate while alive.
//@param real mu     : Constant churn hazard that applies at any moment, not only after purchases.
//@math
// \tau \sim \mathrm{Exponential}(\mu), \quad e = \min(\tau, T), \quad x \sim \mathrm{Poisson}(\lambda e) \\
// t_x = 0 \ \text{if } x = 0, \qquad t_x = e\,U^{1/x},\ U \sim \mathrm{Uniform}(0,1) \ \text{if } x > 0
vector pnbd_indiv_rng(real T, real lambda, real mu){
    real rho = exponential_rng(mu);
    real ex  = rho > T ?  T : rho;
    real x   = poisson_rng(lambda* ex);  

    vector[2] ret;
    ret[1] = x;
    if(x == 0){
        ret[2] = 0;
    }else{
        real U = uniform_rng(0, 1);
        ret[2] = ex * pow(U, 1 / x);
    }
    return ret;
}

//@laplace 
//@brief Pareto-Negative Binomial Random Number Generator
//@param real T              : Time from the first purchase to the end of the data.
//@param real r, real alpha  : lambda ~ Gamma(r, alpha);
//@param real s, real beta   : mu     ~ Gamma(s, beta);
//@math
// \lambda \sim \mathrm{Gamma}(r, \alpha), \quad \mu \sim \mathrm{Gamma}(s, \beta) \\
// (x, t_x) = \texttt{pnbd\_indiv\_rng}(T, \lambda, \mu)
vector pnbd_rng(real T, real r, real alpha, real s, real beta){
    real lambda = gamma_rng(r, alpha);
    real mu     = gamma_rng(s, beta);
    return pnbd_indiv_rng(T, lambda, mu);
}

