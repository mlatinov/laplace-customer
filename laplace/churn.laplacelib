// Libraries 
library{
    import survival
    import cluster
}

// Conditional survival and churn probability for active customers =====================================================================

// Gompertz Models Functions and Overloads ---------------------------------------------------------------------------------------------
//@laplace
//@brief Increase in Gompertz cumulative hazard over the look-ahead window, Delta H = H(u + s) - H(u).
//@param vector u   : Current tenure of each active customer (u >= 0).
//@param real s     : Look-ahead window length (s > 0), in the same time unit as u.
//@param real gamma : Change in log hazard per unit of time, shared by all customers.
//@param real eta   : Log hazard at t = 0, shared by all customers.
//@return vector    : Delta H for each customer (>= 0).
//@math
// \Delta H(u, s) = H(u+s) - H(u) = e^{\eta}\,\frac{e^{\gamma(u+s)} - e^{\gamma u}}{\gamma}
vector churn_gompertz_delta_H(vector u, real s, real gamma, real eta){
    int N = num_elements(u);

    // Get the Cumulative Gompertz Models as H(u + s) and H(u) 
    vector[N] Hsu = survival::srv_gompertz_cumulative_hazard(u + s, gamma, eta);
    vector[N] Hu  = survival::srv_gompertz_cumulative_hazard(u, gamma, eta);

    // Calculate delta 
    return Hsu - Hu;
}

//@laplace
//@brief Increase in Gompertz cumulative hazard over the look-ahead window, per-customer gamma and eta.
//@param vector u     : Current tenure of each active customer (u >= 0).
//@param real s       : Look-ahead window length (s > 0), in the same time unit as u.
//@param vector gamma : Per-customer change in log hazard per unit of time.
//@param vector eta   : Per-customer log hazard at t = 0.
//@return vector      : Delta H for each customer (>= 0).
//@math
// \Delta H_n(u_n, s) = e^{\eta_n}\,\frac{e^{\gamma_n(u_n+s)} - e^{\gamma_n u_n}}{\gamma_n}
vector churn_gompertz_delta_H(vector u, real s, vector gamma, vector eta){
    int N = num_elements(u);

    // Get the Cumulative Gompertz Models as H(u + s) and H(u) 
    vector[N] Hsu = survival::srv_gompertz_cumulative_hazard(u + s, gamma, eta);
    vector[N] Hu  = survival::srv_gompertz_cumulative_hazard(u, gamma, eta);

    // Calculate delta 
    return Hsu - Hu;
}

//@laplace
//@brief Increase in Gompertz cumulative hazard over the look-ahead window, shared gamma and per-customer eta.
//@param vector u   : Current tenure of each active customer (u >= 0).
//@param real s     : Look-ahead window length (s > 0), in the same time unit as u.
//@param real gamma : Change in log hazard per unit of time, shared by all customers.
//@param vector eta : Per-customer log hazard at t = 0 (e.g. X * beta).
//@return vector    : Delta H for each customer (>= 0).
//@math
// \Delta H_n(u_n, s) = e^{\eta_n}\,\frac{e^{\gamma(u_n+s)} - e^{\gamma u_n}}{\gamma}
vector churn_gompertz_delta_H(vector u, real s, real gamma, vector eta){
    int N = num_elements(u);

    // Get the Cumulative Gompertz Models as H(u + s) and H(u) 
    vector[N] Hsu = survival::srv_gompertz_cumulative_hazard(u + s, gamma, eta);
    vector[N] Hu  = survival::srv_gompertz_cumulative_hazard(u, gamma, eta);

    // Calculate delta 
    return Hsu - Hu;
}

// Makeham Model Functions and Overloads ---------------------------------------------------------------------------------------------
//@laplace
//@brief Increase in Gompertz-Makeham cumulative hazard over the look-ahead window, Delta H = H(u + s) - H(u).
//@param vector u   : Current tenure of each active customer (u >= 0).
//@param real s     : Look-ahead window length (s > 0), in the same time unit as u.
//@param real a     : Constant background hazard (a >= 0), shared by all customers.
//@param real gamma : Growth rate of the exponential component.
//@param real eta   : Log of the exponential component's scale b, shared by all customers.
//@return vector    : Delta H for each customer (>= 0).
//@math
// \Delta H(u, s) = a\,s + e^{\eta}\,\frac{e^{\gamma(u+s)} - e^{\gamma u}}{\gamma}
vector churn_makeham_delta_H(vector u, real s, real a, real gamma, real eta){
    int N = num_elements(u);

    // Get the Cumulative Makeham Hazard as H(u + s) and H(u)
    vector[N] Hsu = survival::srv_makeham_cumulative_hazard(u + s, a, gamma, eta);
    vector[N] Hu   = survival::srv_makeham_cumulative_hazard(u, a, gamma, eta);

    // Return the delta Hsu  - Hu
    return Hsu - Hu;
}

//@laplace
//@brief Increase in Gompertz-Makeham cumulative hazard over the look-ahead window, per-customer eta.
//@param vector u   : Current tenure of each active customer (u >= 0).
//@param real s     : Look-ahead window length (s > 0), in the same time unit as u.
//@param real a     : Constant background hazard (a >= 0), shared by all customers.
//@param real gamma : Growth rate of the exponential component.
//@param vector eta : Per-customer log of the exponential component's scale b.
//@return vector    : Delta H for each customer (>= 0).
//@math
// \Delta H_n(u_n, s) = a\,s + e^{\eta_n}\,\frac{e^{\gamma(u_n+s)} - e^{\gamma u_n}}{\gamma}
vector churn_makeham_delta_H(vector u, real s, real a, real gamma, vector eta){
    int N = num_elements(u);

    // Get the Cumulative Makeham Hazard as H(u + s) and H(u)
    vector[N] Hs_u = survival::srv_makeham_cumulative_hazard(u + s, a , gamma, eta);
    vector[N] Hu   = survival::srv_makeham_cumulative_hazard(u, a, gamma, eta);

    // Return the delta Hsu  - Hu
    return Hs_u - Hu;
}

// Log-Logistics Model and Overloads ------------------------------------------------------------------------------------------------
//@laplace
//@brief Increase in log-logistic cumulative hazard over the look-ahead window, Delta H = H(u + s) - H(u).
//@param vector u    : Current tenure of each active customer (u >= 0).
//@param real s      : Look-ahead window length (s > 0), in the same time unit as u.
//@param real alpha  : Scale parameter (alpha > 0), the median lifetime; shared by all customers.
//@param real beta   : Shape parameter (beta > 0); shared by all customers.
//@return vector     : Delta H for each customer (>= 0).
//@math
// \Delta H(u, s) = \log\left(1 + \left(\tfrac{u+s}{\alpha}\right)^{\beta}\right) - \log\left(1 + \left(\tfrac{u}{\alpha}\right)^{\beta}\right)
vector churn_log_logistics_delta_H(vector u, real s, real alpha, real beta){
    int N = num_elements(u);

    // Get the Cumulative Log-Logistic Hazard as H(u + s) and H(u)
    vector[N] Hs_u = survival::srv_log_logistics_cumulative_hazard(u + s, alpha, beta);
    vector[N] Hu  =  survival::srv_log_logistics_cumulative_hazard(u, alpha, beta);

    // Return delta Cumulative Hazard
    return Hs_u - Hu;
}

//@laplace
//@brief Increase in log-logistic cumulative hazard over the look-ahead window, per-customer alpha and beta.
//@param vector u      : Current tenure of each active customer (u >= 0).
//@param real s        : Look-ahead window length (s > 0), in the same time unit as u.
//@param vector alpha  : Per-customer scale parameter (alpha > 0).
//@param vector beta   : Per-customer shape parameter (beta > 0).
//@return vector       : Delta H for each customer (>= 0).
//@math
// \Delta H_n(u_n, s) = \log\left(1 + \left(\tfrac{u_n+s}{\alpha_n}\right)^{\beta_n}\right) - \log\left(1 + \left(\tfrac{u_n}{\alpha_n}\right)^{\beta_n}\right)
vector churn_log_logistics_delta_H(vector u, real s, vector alpha, vector beta){
    int N = num_elements(u);

    // Get the Cumulative Log-Logistic Hazard as H(u + s) and H(u)
    vector[N] Hs_u = survival::srv_log_logistics_cumulative_hazard(u + s, alpha, beta);
    vector[N] Hu  =  survival::srv_log_logistics_cumulative_hazard(u, alpha, beta);

    // Return delta Cumulative Hazard
    return Hs_u - Hu;
}

// Common AFT case, covariates in alpha (log alpha = X * b), one shared shape beta.
//@laplace
//@brief Increase in log-logistic cumulative hazard over the look-ahead window, per-customer alpha and shared beta (AFT covariates).
//@param vector u      : Current tenure of each active customer (u >= 0).
//@param real s        : Look-ahead window length (s > 0), in the same time unit as u.
//@param vector alpha  : Per-customer scale parameter (alpha > 0), e.g. exp(b0 + X * b).
//@param real beta     : Shape parameter (beta > 0), shared by all customers.
//@return vector       : Delta H for each customer (>= 0).
//@math
// \Delta H_n(u_n, s) = \log\left(1 + \left(\tfrac{u_n+s}{\alpha_n}\right)^{\beta}\right) - \log\left(1 + \left(\tfrac{u_n}{\alpha_n}\right)^{\beta}\right)
vector churn_log_logistics_delta_H(vector u, real s, vector alpha, real beta){
    int N = num_elements(u);
    vector[N] beta_v = rep_vector(beta, N);

    // Get the Cumulative Log-Logistic Hazard as H(u + s) and H(u)
    vector[N] Hs_u = survival::srv_log_logistics_cumulative_hazard(u + s, alpha, beta_v);
    vector[N] Hu  =  survival::srv_log_logistics_cumulative_hazard(u, alpha, beta_v);

    // Return delta Cumulative Hazard
    return Hs_u - Hu;
}

// Agnostic function to the model --------------------------------------------------------------------------------------------
//@laplace
//@brief Conditional survival: probability a customer active at tenure u is still active at u + s.
//@param vector dH : Delta H from any churn_<model>_delta_H function.
//@return vector   : S(u + s | u) for each customer, in (0, 1].
//@math
// S(u+s \mid u) = \frac{S(u+s)}{S(u)} = \exp\left(-\Delta H\right)
vector churn_cond_surv(vector dH){
    return exp(-dH);
}

//@laplace
//@brief Churn probability: probability a customer active at tenure u cancels before u + s.
//@param vector dH : Delta H from any churn_<model>_delta_H function.
//@return vector   : P(churn in (u, u + s]) for each customer, in [0, 1).
//@math
// P_{\text{churn}} = 1 - \exp\left(-\Delta H\right) = -\operatorname{expm1}\left(-\Delta H\right)
vector churn_prob(vector dH){
    return -expm1(-dH);
}

// Restricted mean residual lifetime =====================================================================================

// Gompertz RMRL -------------------------------------------------------------------------------------------
//@laplace 
//@brief Restricted mean residual lifetime from the Gompertz model: expected time subscribed during the next tau, given active at tenure u.
//@param real u         : Current tenure (u >= 0).
//@param real gamma     : Change in log hazard per unit of time.
//@param real eta       : Log hazard at t = 0 for this customer.
//@param data vector xq : Quadrature nodes on [0, tau], from quad_nodes().
//@param data vector wq : Quadrature weights, from quad_weights().
//@return real          : RMRL(u, tau), in [0, tau].
//@math
// \mathrm{RMRL}(u,\tau) = \int_0^{\tau} S(u+s \mid u)\,ds \approx \sum_{g} w_g \exp\left(-H_G(x_g;\ \gamma,\ \eta + \gamma u)\right) \\
// \text{using the shift identity } H_G(u+s) - H_G(u) = H_G(s;\ \gamma,\ \eta + \gamma u)
real churn_gompertz_rmrl(real u, real gamma, real eta, data vector xq, data vector wq){
    int N       = num_elements(xq);
    vector[N] H = survival::srv_gompertz_cumulative_hazard(xq, gamma, eta + gamma * u);
    return dot_product(wq, exp(-H));
}

// Makeham RMRL -----------------------------------------------------------------------------------------------------
//@laplace 
//@brief Restricted mean residual lifetime from the Gompertz-Makeham model: expected time subscribed during the next tau, given active at tenure u.
//@param real u         : Current tenure (u >= 0).
//@param real a         : Constant background hazard (a >= 0).
//@param real gamma     : Growth rate of the exponential component.
//@param real eta       : Log of the exponential component's scale b for this customer.
//@param data vector xq : Quadrature nodes on [0, tau], from quad_nodes().
//@param data vector wq : Quadrature weights, from quad_weights().
//@return real          : RMRL(u, tau), in [0, tau].
//@math
// \mathrm{RMRL}(u,\tau) \approx \sum_{g} w_g \exp\left(-H_M(x_g;\ a,\ \gamma,\ \eta + \gamma u)\right),
// \quad H_M(u+s) - H_M(u) = a\,s + H_G(s;\ \gamma,\ \eta + \gamma u)
real churn_makeham_rmrl(real u, real a, real gamma, real eta, data vector xq, data vector wq){
    return dot_product(wq, exp(-(survival::srv_makeham_cumulative_hazard(xq, a, gamma, eta + gamma * u))));
}

// Log-logistics RMRL -----------------------------------------------------------------------------------------------------
//@laplace
//@brief Restricted mean residual lifetime from the log-logistic model: expected time subscribed during the next tau, given active at tenure u. No shift identity, so H(u) is subtracted explicitly.
//@param real u         : Current tenure (u >= 0).
//@param real alpha     : Scale parameter (alpha > 0) for this customer.
//@param real beta      : Shape parameter (beta > 0).
//@param data vector xq : Quadrature nodes on [0, tau], from quad_nodes().
//@param data vector wq : Quadrature weights, from quad_weights().
//@return real          : RMRL(u, tau), in [0, tau].
//@math
// \mathrm{RMRL}(u,\tau) \approx \sum_{g} w_g \exp\left(-\left[H_{LL}(u + x_g) - H_{LL}(u)\right]\right)
// = \sum_{g} w_g\,\frac{1 + (u/\alpha)^{\beta}}{1 + \left((u + x_g)/\alpha\right)^{\beta}}
real churn_log_logistics_rmrl(real u, real alpha, real beta, data vector xq, data vector wq){
    int N       = num_elements(xq);
    real Hu     = survival::srv_log_logistics_cumulative_hazard(u, alpha, beta);
    vector[N] H = survival::srv_log_logistics_cumulative_hazard(u + xq, alpha, beta);
    return dot_product(wq, exp(-(H - Hu)));
}

// Subscription value (contractual CLV) ==========================================================================================================================
//@laplace 
//@brief Discrete subscription value: expected dnum_elementiscounted margin from an active customer over the next K billing periods, paid at the start of each period while subscribed.
//@param vector S_cond : Conditional survival S(u + k | u) for k = 0, 1, ..., K (first element is 1, the payment due now).
//@param real m        : Margin per billing period.
//@param real d        : Discount rate per billing period.
//@return real         : Expected present value of the customer's future payments.
//@math
// V_{\text{disc}} = m \sum_{k=0}^{K} \frac{S(u+k \mid u)}{(1+d)^{k}}
real churn_value_discrete(vector S_cond, real m, real d) {
    int K = num_elements(S_cond) - 1;
    real v_disc = 0;

    for (k in 0:K)
        v_disc += S_cond[k + 1] / pow(1 + d, k);

    return m * v_disc;
}

//@laplace 
//@brief Continuous subscription value for a Gompertz customer: expected revenue from now until the horizon tau, expressed in today's money.
//@param real u         : Current tenure (u >= 0).
//@param real m         : Margin per unit time (a rate), in the same time unit as u and tau.
//@param real delta     : Continuous discount rate per unit time (delta >= 0).
//@param real gamma     : Change in log hazard per unit of time for this customer.
//@param real eta       : Log hazard at t = 0 for this customer.
//@param data vector xq : Quadrature nodes on [0, tau], from quad_nodes().
//@param data vector wq : Quadrature weights, from quad_weights().
//@return real          : Expected present value of revenue over the next tau.
//@math
// V_{\text{cont}} = m \int_0^{\tau} e^{-\delta s}\, S(u+s \mid u)\, ds
//   \approx m \sum_{g} w_g\, e^{-\delta x_g} \exp\left(-H_G(x_g;\ \gamma,\ \eta + \gamma u)\right)
real churn_gompertz_value(real u, real m, real delta, real gamma, real eta, data vector xq, data vector wq){
    int N = num_elements(xq);
    real v_cont = 0;

    for (i in 1:N){
        // Conditional cumulative hazard over (u, u + x_i], via the Gompertz shift identity
        real Hg = survival::srv_gompertz_cumulative_hazard(xq[i], gamma, eta + gamma * u);
        // Discount factor: value today of money received at time x_i
        real disc_node = exp(-delta * xq[i]);
        // Accumulate weight * discount * conditional survival
        v_cont += wq[i] * disc_node * exp(-Hg);
    }
    return m * v_cont;
}

// Mixture cure model: Customers who never churn ======================================================================================

// Generic Agnostic Functions ---------------------------------------------------------------------------------------------------------
//@laplace 
//@brief Generic Churn Cure Log-Likelihood Function 
//@param vector log_h : Log of a Hazard function
//@param vector H     : Cumulative Hazard Function 
//@param vector psi   : Log odds of being a never-churner 
//@param vector d     : Event indicator 
//@return vector      : Pointwise log likelihood l_n for each customer (for LOO / WAIC).
//@math
// \pi_n = \operatorname{logit}^{-1}(\psi_n) \\
// \ell_n = d_n\left[\log(1-\pi_n) + \log h(t_n) - H(t_n)\right] + (1-d_n)\log\left(\pi_n + (1-\pi_n)\,e^{-H(t_n)}\right)
vector churn_cure_loglik(vector log_h, vector H, vector psi, data vector d){
    int N = num_elements(H);
    vector[N] pn       = inv_logit(psi);
    vector[N] log_pn   = log_inv_logit(psi);
    return d .* (log(1 - pn) + log_h  - H) + (1 - d) .* log(exp(log_pn) + exp(log1m_inv_logit(psi) - H));
}

vector churn_cure_loglik(vector log_h, vector H, real psi, data vector d){
    int N = num_elements(H);
    real pn       = inv_logit(psi);
    real log_pn   = log_inv_logit(psi);
    return d .* (log(1 - pn) + log_h  - H) + (1 - d) .* log(exp(log_pn) + exp(log1m_inv_logit(psi) - H));
}


//@laplace 
//@brief Generic Churn Cure Sum Log-Likelihood Function 
//@param vector log_h : Log of a Hazard function
//@param vector H     : Cumulative Hazard Function 
//@param vector psi   : Log odds of being a never-churner 
//@param vector d     : Event indicator 
//@return real        : Total log likelihood, summed over customers (for target +=).
//@math
// \log L = \sum_{n=1}^{N} \ell_n = \sum_{n=1}^{N} \left\{ d_n\left[\log(1-\pi_n) + \log h(t_n) - H(t_n)\right] + (1-d_n)\log\left(\pi_n + (1-\pi_n)\,e^{-H(t_n)}\right) \right\}
real churn_cure_ll(vector log_h, vector H, vector psi, data vector d){
    return sum(churn_cure_loglik(log_h, H, psi, d));
}
real churn_cure_ll(vector log_h, vector H, real psi, data vector d){
    return sum(churn_cure_loglik(log_h, H, psi, d));
}

//@laplace 
//@brief Loyalty score: Probability a customer is a never-churner given how long they have already stayed
//@param psi          : Log-odds of being a never-churner.
//@param H            : Cumulative Hazard Function 
//@return vector      : P(loyal | T_n > t_n) in (0, 1) for each customer; meaningful for active customers (d = 0) only.
//@math
// P(\text{loyal} \mid T_n > t_n) = \frac{\pi_n}{\pi_n + (1-\pi_n)\,e^{-H(t_n)}} = \operatorname{logit}^{-1}\left(\psi_n + H(t_n)\right)
vector churn_cure_p_loyal(vector psi, vector H){
    return inv_logit(H + psi);
}
vector churn_cure_p_loyal(real psi, vector H){
    return inv_logit(H + psi);
}

// Gompertz Cure Functions ------------------------------------------------------------------------------------------------------------------------------------------------------ 
//@laplace
//@brief Churn Cure Gompertz Log pointwise Density function 
//@param vector t   : Time since origin t > 0. 
//@param real gamma : Change in log hazard per unit of time for this customer.
//@param vector eta : Per-customer log hazard at t = 0.
//@param vector psi : Log-odds of being a never-churner.
//@param data vector d : Event Indicator.
//@return real      : Total log likelihood of the Gompertz mixture cure model, summed over customers.
//@math
// \log h(t_n) = \eta_n + \gamma t_n, \quad H(t_n) = e^{\eta_n}\,\frac{e^{\gamma t_n} - 1}{\gamma} \\
// \log L = \sum_{n=1}^{N} \left\{ d_n\left[\log(1-\pi_n) + \eta_n + \gamma t_n - H(t_n)\right] + (1-d_n)\log\left(\pi_n + (1-\pi_n)\,e^{-H(t_n)}\right) \right\}
real churn_cure_gompertz_lpdf(vector t , real gamma, vector eta, vector psi, data vector d){
    // Get the Gompertz Cumulative Hazard and log Hazard
    vector[num_elements(t)] H = survival::srv_gompertz_cumulative_hazard(t, gamma, eta);
    vector[num_elements(t)] h = survival::srv_gompertz_log_hazard(t, gamma, eta);

    // Return the Churn Cure Gompertz Log pointwise Density
    return churn_cure_ll(h, H, psi, d); 
}
real churn_cure_gompertz_lpdf(vector t , real gamma, vector eta, real psi, data vector d){
    // Get the Gompertz Cumulative Hazard and log Hazard
    vector[num_elements(t)] H = survival::srv_gompertz_cumulative_hazard(t, gamma, eta);
    vector[num_elements(t)] h = survival::srv_gompertz_log_hazard(t, gamma, eta);

    // Return the Churn Cure Gompertz Log pointwise Density
    return churn_cure_ll(h, H, psi, d); 
}
real churn_cure_gompertz_lpdf(vector t , vector gamma, vector eta, vector psi, data vector d){
    // Get the Gompertz Cumulative Hazard and log Hazard
    vector[num_elements(t)] H = survival::srv_gompertz_cumulative_hazard(t, gamma, eta);
    vector[num_elements(t)] h = survival::srv_gompertz_log_hazard(t, gamma, eta);

    // Return the Churn Cure Gompertz Log pointwise Density
    return churn_cure_ll(h, H, psi, d); 
}
real churn_cure_gompertz_lpdf(vector t , vector gamma, vector eta, real psi, data vector d){
    // Get the Gompertz Cumulative Hazard and log Hazard
    vector[num_elements(t)] H = survival::srv_gompertz_cumulative_hazard(t, gamma, eta);
    vector[num_elements(t)] h = survival::srv_gompertz_log_hazard(t, gamma, eta);

    // Return the Churn Cure Gompertz Log pointwise Density
    return churn_cure_ll(h, H, psi, d); 
}

//@laplace 
//@brief Churn Cure Gompertz Random Number Generator 
//@param real gamma     : Change in log hazard per unit of time for this customer.
//@param real eta       : Log hazard at t = 0 for this customer.
//@param vector psi     : Log-odds of being a never-churner.
//@return real          : One simulated tenure; positive_infinity() for a never-churner (or a cured Gompertz draw when gamma < 0).
//@math
// L \sim \mathrm{Bernoulli}\left(\operatorname{logit}^{-1}(\psi)\right) \\
// T = \infty \ \text{if } L = 1, \qquad T = \frac{1}{\gamma}\log\left(1 + \gamma E e^{-\eta}\right),\ E \sim \mathrm{Exponential}(1) \ \text{if } L = 0 \\
// T = \infty \ \text{also when } 1 + \gamma E e^{-\eta} \le 0 \ (\gamma < 0)
real churn_cure_gompertz_rng(real gamma, real eta, real psi){
    // Draw from bernoulli dist inv of psi 
    int L  = bernoulli_logit_rng(psi);
    
    if(L == 1){
        return positive_infinity();
    }else{
        return survival::srv_gompertz_rng(gamma, eta);
    }
}

// Makeham Cure Functions ----------------------------------------------------------------------------------------------------------------------------------------------
//@laplace 
//@brief Churn Cure Makeham Log pointwise Density function 
//@param vector t   : Time since origin t > 0. 
//@param real gamma : Change in log hazard per unit of time for this customer.
//@param vector eta : Per-customer log hazard at t = 0.
//@param vector psi : Log-odds of being a never-churner.
//@param data vector d : Event Indicator.
//@return real      : Total log likelihood of the Makeham mixture cure model, summed over customers.
//@math
// \pi_n = \operatorname{logit}^{-1}(\psi_n) \\
// \log h(t_n) = \log\left(a + e^{\eta_n + \gamma t_n}\right), \quad H(t_n) = a\,t_n + e^{\eta_n}\,\frac{e^{\gamma t_n} - 1}{\gamma} \\
// \log L = \sum_{n=1}^{N} \left\{ d_n\left[\log(1-\pi_n) + \log h(t_n) - H(t_n)\right] + (1-d_n)\log\left(\pi_n + (1-\pi_n)\,e^{-H(t_n)}\right) \right\}
real churn_cure_makeham_lpdf(vector t, real a, real gamma, vector eta, vector psi, data vector d){
    // Get the Makeham Cumulative Hazard and log Hazard
    vector[num_elements(t)] H = survival::srv_makeham_cumulative_hazard(t, a, gamma, eta);
    vector[num_elements(t)] h = survival::srv_makeham_log_hazard(t, a, gamma, eta);

    // Return the Churn Cure Makeham Log pointwise Density
    return churn_cure_ll(h, H, psi, d);
}
real churn_cure_makeham_lpdf(vector t, vector a, real gamma, vector eta, vector psi, data vector d){
    // Get the Makeham Cumulative Hazard and log Hazard
    vector[num_elements(t)] H = survival::srv_makeham_cumulative_hazard(t, a, gamma, eta);
    vector[num_elements(t)] h = survival::srv_makeham_log_hazard(t, a, gamma, eta);

    // Return the Churn Cure Makeham Log pointwise Density
    return churn_cure_ll(h, H, psi, d);
}
real churn_cure_makeham_lpdf(vector t, vector a, real gamma, vector eta, real psi, data vector d){
    // Get the Makeham Cumulative Hazard and log Hazard
    vector[num_elements(t)] H = survival::srv_makeham_cumulative_hazard(t, a, gamma, eta);
    vector[num_elements(t)] h = survival::srv_makeham_log_hazard(t, a, gamma, eta);

    // Return the Churn Cure Makeham Log pointwise Density
    return churn_cure_ll(h, H, psi, d);
}
real churn_cure_makeham_lpdf(vector t, real a, real gamma, vector eta, real psi, data vector d){
    // Get the Makeham Cumulative Hazard and log Hazard
    vector[num_elements(t)] H = survival::srv_makeham_cumulative_hazard(t, a, gamma, eta);
    vector[num_elements(t)] h = survival::srv_makeham_log_hazard(t, a, gamma, eta);

    // Return the Churn Cure Makeham Log pointwise Density
    return churn_cure_ll(h, H, psi, d);
}

//@laplace 
//@brief Churn Cure Makeham Random Number Generator 
//@param real a         : Constant background hazard (a >= 0).
//@param real gamma     : Change in log hazard per unit of time for this customer.
//@param real eta       : Log hazard at t = 0 for this customer.
//@param vector psi     : Log-odds of being a never-churner.
//@return real          : One simulated tenure; positive_infinity() for a never-churner (or a cured Gompertz draw when gamma < 0).
//@math
// L \sim \mathrm{Bernoulli}\left(\operatorname{logit}^{-1}(\psi)\right) \\
// T = \infty \ \text{if } L = 1, \qquad T = \min(T_a, T_G) \ \text{if } L = 0 \\
// T_a \sim \mathrm{Exponential}(a), \quad T_G = \frac{1}{\gamma}\log\left(1 + \gamma E e^{-\eta}\right),\ E \sim \mathrm{Exponential}(1) \ (T_G = \infty \text{ when } 1 + \gamma E e^{-\eta} \le 0)
real churn_cure_makeham_rng(real a, real gamma, real eta, real psi){
    int L = bernoulli_logit_rng(psi);

    if(L == 0){
        return positive_infinity();
    }else{
        real Ta = exponential_rng(log(a));
        real Tg = survival::srv_gompertz_rng(gamma, eta); 
        return Ta < Tg ? Ta : Tg;
    }
}

// Log-Logistics Cure Functions ----------------------------------------------------------------------------------------------------------------------------------------
//@laplace 
//@brief Churn Cure Log-Logistics Log pointwise Density function 
//@param vector t   : Time since origin t > 0. 
//@param real alpha : Scale parameter (alpha > 0).
//@param real beta    : Shape parameter (beta > 0).
//@param vector psi   : Log-odds of being a never-churner.
//@param data vector d : Event Indicator.
//@return real         : Total log likelihood of the Log-Logistics mixture cure model, summed over customers.
//@math
// \pi_n = \operatorname{logit}^{-1}(\psi_n) \\
// \log h(t_n) = \log\beta - \log\alpha_n + (\beta - 1)\left(\log t_n - \log\alpha_n\right) - \operatorname{log1p}\left((t_n/\alpha_n)^{\beta}\right), \quad H(t_n) = \operatorname{log1p}\left((t_n/\alpha_n)^{\beta}\right) \\
// \log L = \sum_{n=1}^{N} \left\{ d_n\left[\log(1-\pi_n) + \log h(t_n) - H(t_n)\right] + (1-d_n)\log\left(\pi_n + (1-\pi_n)\,e^{-H(t_n)}\right) \right\}
real churn_cure_log_logistics_lpdf(vector t, real alpha, real beta, vector psi, data vector d){
    // Get the Log-Logistics Cumulative Hazard and log Hazard
    vector[num_elements(t)] H = survival::srv_log_logistics_cumulative_hazard(t, alpha, beta);
    vector[num_elements(t)] h = survival::srv_log_logistics_log_hazard(t, alpha, beta);

    // Return the Churn Cure Log-Logistics Log pointwise Density
    return churn_cure_ll(h, H, psi, d);
}
real churn_cure_log_logistics_lpdf(vector t, vector alpha, vector beta, vector psi, data vector d){
    // Get the Log-Logistics Cumulative Hazard and log Hazard
    vector[num_elements(t)] H = survival::srv_log_logistics_cumulative_hazard(t, alpha, beta);
    vector[num_elements(t)] h = survival::srv_log_logistics_log_hazard(t, alpha, beta);

    // Return the Churn Cure Log-Logistics Log pointwise Density
    return churn_cure_ll(h, H, psi, d);
}

//@laplace 
//@brief Churn Cure Log-Logistics Random Number Generator 
//@param real alpha : Scale parameter (alpha > 0).
//@param real beta    : Shape parameter (beta > 0).
//@param real psi     : Log-odds of being a never-churner.
//@return real          : One simulated tenure; positive_infinity() for a never-churner (or alpha * pow((U / 1- U), 1 / beta) where U ~ uniform(0, 1)).
//@math
// L \sim \mathrm{Bernoulli}\left(\operatorname{logit}^{-1}(\psi)\right) \\
// T = \infty \ \text{if } L = 1, \qquad T = \alpha\left(\frac{U}{1-U}\right)^{1/\beta},\ U \sim \mathrm{Uniform}(0,1) \ \text{if } L = 0
real churn_cure_log_logistics_rng(real alpha, real beta, real psi){
    int L = bernoulli_logit_rng(psi);
    
    if(L == 1){
        return positive_infinity();
    }else{
        real U = uniform_rng(0, 1);
        return alpha * pow((U / (1- U)), 1 / beta);
    }
}

// Gamma frailty: unmeasured loyalty ======================================================================================================================================
/*
Allow customers with identical covariates to differ in an unmeasured propensity to churn, and
estimate each customer’s propensity from their own history.
*/

// Generic Agnostics Functions -------------------------------------------------------------------------------------------------------------------------------------------
//@laplace 
//@brief Generic Churn Fragility Log-Likelihood
//@param vector log_h  : Log Hazard Function 
//@param vector H      : Cumulative Hazard Function 
//@param real theta    : Fragility Variance
//@param data vector d : Event Indicator  
//@return vector of Fragility Log-Likelihood
//@math
// \omega_n \sim \mathrm{Gamma}(1/\theta,\, 1/\theta) \\
// \ell_n = d_n\left[\log h(t_n) - \operatorname{log1p}\left(\theta H(t_n)\right)\right] - H(t_n)\,\frac{\operatorname{log1p}\left(\theta H(t_n)\right)}{\theta H(t_n)}
vector churn_frailty_loglik(vector log_h, vector H, real theta, data vector d){
    return d .* (log_h - log1p(theta * H)) - H .* ((log1p(theta * H)) ./ (theta * H));
}

//@laplace 
//@brief Generic Churn Sum Fragility Log-Likelihood 
//@param vector log_h  : Log Hazard Function 
//@param vector H      : Cumulative Hazard Function  
//@param real theta    : Fragility Variance
//@param data vector d : Event Indicator  
//@return real Sum of the Fragility Log-Likelihood
//@math
// \log L = \sum_{n=1}^{N} \left\{ d_n\left[\log h(t_n) - \operatorname{log1p}\left(\theta H(t_n)\right)\right] - \frac{1}{\theta}\operatorname{log1p}\left(\theta H(t_n)\right) \right\}
real churn_frailty_ll(vector log_h, vector H, real theta, data vector d){
    return sum(churn_frailty_loglik(log_h, H, theta, d));
}

//@laplace 
//@brief Churn Fragility Score 
//@param vector H      : Cumulative Hazard Function 
//@param real theta    : Fragility Variance
//@param data vector d : Event Indicator
//@return vector Per customer, posterior mean of their personal hazard multiplier ωn
//@math
// \omega_n \mid t_n, d_n \sim \mathrm{Gamma}\left(1/\theta + d_n,\ 1/\theta + H(t_n)\right) \\
// \mathbb{E}[\omega_n \mid t_n, d_n] = \frac{1 + \theta d_n}{1 + \theta H(t_n)}
vector churn_frailty_score(vector H, real theta, data vector d){
    return (1 + theta *d) ./ (1 + theta * H);
}

//@laplace 
//@brief Churn Fragility Survival 
//@param vector H_u  : Current Baseline Cumulative Hazard Function H(u) for active customers
//@param vector H_us : Future Window Baseline Cumulative Hazard Function H(u + s) for active customers
//@param real theta  : Fragility Variance
//@return vector Churn outlook for an active customers
//@math
// S(u_n + s \mid u_n) = \left(\frac{1 + \theta H(u_n)}{1 + \theta H(u_n + s)}\right)^{1/\theta} \\
// \theta \to 0: \quad S(u_n + s \mid u_n) = e^{-\left[H(u_n + s) - H(u_n)\right]}
vector churn_frailty_cond_surv(vector H_u, vector H_us, real theta){
    return pow((1 + theta * H_u) ./ (1 + theta * H_us), 1 / theta);
}

// Gompertz Functions -----------------------------------------------------------------------------------------------------------------------------------------------------
//@laplace 
//@brief Churn Fragility Gompertz Log Pointwise Density Function 
//@param vector t      : Time since origin t > 0. 
//@param real gamma    : Change in log hazard per unit of time for this customer.
//@param vector eta    : Per-customer log hazard at t = 0.
//@param real theta    : Fragility Variance
//@param data vector d : Event Indicator 
//@return real Gompertz Sum of the Fragility Log-Likelihood
//@math
// \log h(t_n) = \eta_n + \gamma t_n, \quad H(t_n) = e^{\eta_n}\,\frac{e^{\gamma t_n} - 1}{\gamma} \\
// \log L = \sum_{n=1}^{N} \left\{ d_n\left[\log h(t_n) - \operatorname{log1p}\left(\theta H(t_n)\right)\right] - \frac{1}{\theta}\operatorname{log1p}\left(\theta H(t_n)\right) \right\}
real churn_frailty_gompertz_lpdf(vector t, real gamma, vector eta, real theta, data vector d){
    int N = num_elements(t);

    // Calculate Cumulative Hazard Function and Log Hazard Function 
    vector[N] H     = survival::srv_gompertz_cumulative_hazard(t, gamma, eta);
    vector[N] log_h = survival::srv_gompertz_log_hazard(t, gamma, eta);

    // Calculate Churn Sum Fragility Log-Likelihood
    return churn_frailty_ll(log_h, H, theta, d); 
}

real churn_frailty_gompertz_lpdf(vector t, vector gamma, vector eta, real theta, data vector d){
    int N = num_elements(t);

    // Calculate Cumulative Hazard Function and Log Hazard Function 
    vector[N] H     = survival::srv_gompertz_cumulative_hazard(t, gamma, eta);
    vector[N] log_h = survival::srv_gompertz_log_hazard(t, gamma, eta);

    // Calculate Churn Sum Fragility Log-Likelihood
    return churn_frailty_ll(log_h, H, theta, d); 
}

//@laplace 
//@brief Churn Fragility Gompertz Random Number Generator
//@param real gamma    : Change in log hazard per unit of time for this customer.
//@param vector eta    : Customer log hazard at t = 0.
//@param real theta    : Fragility Variance
//@return real Random Churn Fragility for Gompertz fragility likelihood
//@math
// \omega \sim \mathrm{Gamma}(1/\theta,\, 1/\theta), \quad \eta' = \eta + \log\omega \\
// T = \frac{1}{\gamma}\log\left(1 + \gamma E e^{-\eta'}\right),\ E \sim \mathrm{Exponential}(1) \quad (T = \infty \text{ when } 1 + \gamma E e^{-\eta'} \le 0)
real churn_frailty_gompertz_rng(real gamma, real eta, real theta){
    real E = exponential_rng(1);
    real w = gamma_rng(1 / theta, 1 / theta);

    if(1 + gamma * E * exp(-(eta + log(w))) <= 0){
        return positive_infinity();
    }else{
        return (1 / gamma) * log(1 + gamma * E * exp(-eta)); 
    }
}

// Makeham Functions ------------------------------------------------------------------------------------------------------------------------------------------------------
//@laplace
//@brief Churn Fragility Makeham Log Pointwise Density Function 
//@param vector t       : Time since origin t > 0.
//@param real a         : Constant background hazard (a >= 0).
//@param real gamma     : Change in log hazard per unit of time for this customer.
//@param real eta       : Log hazard at t = 0 for this customer.
//@param real theta     : Fragility Variance
//@param data vector d  : Event Indicator 
//@return real  : Sum of the Fragility Log-Likelihood from Makeham Fragility Model
//@math
// \log h(t_n) = \log\left(a + e^{\eta_n + \gamma t_n}\right), \quad H(t_n) = a\,t_n + e^{\eta_n}\,\frac{e^{\gamma t_n} - 1}{\gamma} \\
// \log L = \sum_{n=1}^{N} \left\{ d_n\left[\log h(t_n) - \operatorname{log1p}\left(\theta H(t_n)\right)\right] - \frac{1}{\theta}\operatorname{log1p}\left(\theta H(t_n)\right) \right\}
real churn_frailty_makeham_lpdf(vector t, real a, real gamma, vector eta, real theta, data vector d){
    int N = num_elements(t);

    // Calculate Makeham Cumulative Hazard and Log Hazard Function 
    vector[N] H     = survival::srv_makeham_cumulative_hazard(t, a, gamma, eta);
    vector[N] log_h = survival::srv_makeham_log_hazard(t, a, gamma, eta);
    
    // Return sum of the Fragility Log-Likelihood 
    return churn_frailty_ll(log_h, H, theta, d);
}

real churn_frailty_makeham_lpdf(vector t, vector a, real gamma, vector eta, real theta, data vector d){
    int N = num_elements(t);
    // Calculate Makeham Cumulative Hazard and Log Hazard Function 
    vector[N] H     = survival::srv_makeham_cumulative_hazard(t, a, gamma, eta);
    vector[N] log_h = survival::srv_makeham_log_hazard(t, a, gamma, eta);
    
    // Return sum of the Fragility Log-Likelihood 
    return churn_frailty_ll(log_h, H, theta, d);
}

//@laplace 
//@brief Makeham Fragility Random Number Generator 
//@param real a         : Constant background hazard (a >= 0).
//@param real gamma     : Change in log hazard per unit of time for this customer.
//@param real eta       : Log hazard at t = 0 for this customer.
//@return real : Random Number Generated From Makeham Fragility Model
//@math
// \omega \sim \mathrm{Gamma}(1/\theta,\, 1/\theta) \\
// T = \min(T_a, T_G), \quad T_a \sim \mathrm{Exponential}(\omega a), \quad T_G = \frac{1}{\gamma}\log\left(1 + \gamma E e^{-(\eta + \log\omega)}\right),\ E \sim \mathrm{Exponential}(1)
real churn_frailty_makeham_rng(real a, real gamma, real eta, real theta){
    // Draw w from Gamma Distribution :
    real w = gamma_rng(1 / theta, 1 / theta);
    real Ta = exponential_rng(w * a);
    real Tg = survival::srv_gompertz_rng(gamma, eta + log(w));
    // Return min(Ta, Tg)
    return Ta > Tg ? Tg: Ta;
}

// Log Logistics Functions ------------------------------------------------------------------------------------------------------------------------------------------------
//@laplace 
//@brief Churn Fragility Log-Logistics Log Pointwise Density Function
//@param vector t       : Time since origin t > 0.
//@param real alpha     : Scale parameter (alpha > 0).
//@param real beta      : Shape parameter (beta > 0).
//@param real theta     : Fragility Variance
//@param data vector d  : Event Indicator
//@return real Sum of Fragility Log Likelihood 
//@math
// \log h(t_n) = \log\beta - \log\alpha_n + (\beta - 1)\left(\log t_n - \log\alpha_n\right) - \operatorname{log1p}\left((t_n/\alpha_n)^{\beta}\right), \quad H(t_n) = \operatorname{log1p}\left((t_n/\alpha_n)^{\beta}\right) \\
// \log L = \sum_{n=1}^{N} \left\{ d_n\left[\log h(t_n) - \operatorname{log1p}\left(\theta H(t_n)\right)\right] - \frac{1}{\theta}\operatorname{log1p}\left(\theta H(t_n)\right) \right\}
real churn_frailty_log_logistics_lpdf(vector t, real alpha, real beta, real theta, data vector d){
    int N = num_elements(t);

    // Calculate Cumulative Hazard and Log Hazard Function from Log-Logistics Model
    vector[N] H     = survival::srv_log_logistics_cumulative_hazard(t, alpha, beta);
    vector[N] log_h = survival::srv_log_logistics_log_hazard(t, alpha, beta);

    // Return Sum of Fragility Log Likelihood
    return churn_frailty_ll(log_h, H, theta, d);
}
real churn_frailty_log_logistics_lpdf(vector t, vector alpha, vector beta, real theta, data vector d){
    int N = num_elements(t);

    // Calculate Cumulative Hazard and Log Hazard Function from Log-Logistics Model
    vector[N] H     = survival::srv_log_logistics_cumulative_hazard(t, alpha, beta);
    vector[N] log_h = survival::srv_log_logistics_log_hazard(t, alpha, beta);

    // Return Sum of Fragility Log Likelihood
    return churn_frailty_ll(log_h, H, theta, d);
}

//@laplace
//@brief Churn Fragility Log Logistics Random Number Generator 
//@param real alpha     : Scale parameter (alpha > 0).
//@param real beta      : Shape parameter (beta > 0).
//@param real theta     : Fragility Variance
//@return Random Number Generated from Fragility Log Logistics Model
//@math
// \omega \sim \mathrm{Gamma}(1/\theta,\, 1/\theta), \quad S(t \mid \omega) = \left(1 + (t/\alpha)^{\beta}\right)^{-\omega} \\
// T = \alpha\left(U^{-1/\omega} - 1\right)^{1/\beta},\ U \sim \mathrm{Uniform}(0,1)
real churn_frailty_log_logistics_rng(real alpha, real beta, real theta){
    real U = uniform_rng(0, 1);
    real w = gamma_rng(1 / theta, 1 / theta);
    return alpha * pow((pow(U, -1/ w) - 1), 1 / beta);
}

// Competing risks: Why customers leave ===================================================================================================================================
/*
Model cancellation as the first of several distinct exit routes, each with its own hazard and drivers,
and report the probability of leaving through each route
*/

// Generic Agnostic Functions ---------------------------------------------------------------------------------------------------------------------------------------------
//@laplace
//@brief Churn Competing Log Likelihood 
//@param matrix[n, c] log_h           : Matrix of Log Hazard Functions 
//@param matrix[n, c] H               : Matrix of Cumulative Hazard Functions 
//@param data array[] int cause       : Cause that ended the subscription; 0 = active. 
//@return vector Churn Competing Log Likelihood 
//@math
// S(t) = \exp\left(-\sum_{c=1}^{C} H_c(t)\right) \\
// \ell_n = \mathbb{1}\{c_n > 0\}\,\log h_{c_n}(t_n) - \sum_{c=1}^{C} H_c(t_n)
vector churn_competing_loglik(matrix log_h, matrix H, data array[] int cause){
    int N = num_elements(cause);
    vector[N] ll;

    for (n in 1:N) {
        if (cause[n] > 0) {
            ll[n] = log_h[n, cause[n]] - sum(H[n]);
        } else {
            ll[n] = -sum(H[n]);
        }
    }
    return ll;
}
//@laplace 
//@brief Churn Sum Competing Log Likelihood 
//@param matrix[n, c] log_h           : Matrix of Log Hazard Functions 
//@param matrix[n, c] H               : Matrix of Cumulative Hazard Functions 
//@param data array[] int cause       : Cause that ended the subscription; 0 = active. 
//@return real Sum Competing Log Likelihood 
//@math
// \log L = \sum_{n=1}^{N} \left\{ \mathbb{1}\{c_n > 0\}\,\log h_{c_n}(t_n) - \sum_{c=1}^{C} H_c(t_n) \right\}
real churn_competing_ll(matrix log_h, matrix H, data array[] int cause){
    return sum(churn_competing_loglik(log_h, H, cause));
}

//@laplace 
//@brief Churn Competing Cumulative Incidence Function (CIF)
//@param matrix[i, c] log_h_q : Matrix of Log Hazard Functions over u + xi
//@param matrix[i, c] dH_q    : Matrix of Delta Cumulative Hazard Functions as H_c(u + x_i) - H_c(u)
//@param data vector wd       : Quadrature weights
//@return a vector of Cumulative Incidence
//@math
// F_c(s \mid u) = \int_0^{s} h_c(u + v)\,\exp\left(-\sum_{j=1}^{C}\left[H_j(u + v) - H_j(u)\right]\right) dv \\
// F_c(s \mid u) \approx \sum_{i} w_i \exp\left(\log h_c(u + x_i) - \sum_{j=1}^{C}\left[H_j(u + x_i) - H_j(u)\right]\right) \\
// \sum_{c=1}^{C} F_c(s \mid u) + S(u + s \mid u) = 1
vector churn_competing_cif(matrix log_h_q, matrix dH_q, data vector wq){
    int N = rows(log_h_q);
    int C = cols(log_h_q);

    vector[C] cif;
    
    for (c in 1:C) {
        cif[c] = 0;
        
        for (i in 1:N) {
            real total_dH = 0;
            
            for (j in 1:C) {
                total_dH += dH_q[i, j];
        }
        // Calculate  Cumulative Incidence Function 
        cif[c] += wq[i] * exp(log_h_q[i, c] - total_dH);
        }
    }
    return cif;
}

// Competing Risk Gompertz ------------------------------------------------------------------------------------------------------------------------------
//@laplace
//@brief Churn Competing Risks Gompertz Log Pointwise Density Function 
//@param vector t              : Time since origin t > 0.
//@param vector gamma          : Change in log hazard per unit and cause  .
//@param matrix[n, c] eta      : Per-customer and cause log hazard at t = 0.
//@param data array int cause  : Cause that ended the subscription; 0 = active
//@return real Compering Risk Gompertz Sum Competing Log-Likelihood 
//@math
// \log h_c(t_n) = \eta_{nc} + \gamma_c t_n, \quad H_c(t_n) = e^{\eta_{nc}}\,\frac{e^{\gamma_c t_n} - 1}{\gamma_c} \\
// \log L = \sum_{n=1}^{N} \left\{ \mathbb{1}\{c_n > 0\}\,\log h_{c_n}(t_n) - \sum_{c=1}^{C} H_c(t_n) \right\}
real churn_competing_gompertz_lpdf(vector t, vector gamma, matrix eta, data array[] int cause){
    int N = rows(eta);
    int C = cols(eta);

    matrix[N, C] log_h;
    matrix[N, C] Hc;

    // Calculate the Competing Cumulative Hazard and Competing Log Hazard per cause 
    for(n in 1:N){
        for(c in 1:C){
            log_h[n, c] = survival::srv_gompertz_log_hazard(t[n], eta[n, c], gamma[n]);
            Hc[n, c]    = survival::srv_gompertz_cumulative_hazard(t[n], eta[n, c], gamma[n]);
        }
    }

    // Return the Sum Competing Log-Likelihood 
    return churn_competing_ll(log_h, Hc, cause);
}
real churn_competing_gompertz_lpdf(vector t, matrix gamma, matrix eta, data array[] int cause){
    int N = rows(eta);
    int C = cols(eta);

    matrix[N, C] log_h;
    matrix[N, C] Hc;

    // Calculate the Competing Cumulative Hazard and Competing Log Hazard per cause 
    for(n in 1:N){
        for(c in 1:C){
            log_h[n, c] = survival::srv_gompertz_log_hazard(t[n], eta[n, c], gamma[n, c]);
            Hc[n, c]    = survival::srv_gompertz_cumulative_hazard(t[n], eta[n, c], gamma[n, c]);
        }
    }

    // Return the Sum Competing Log-Likelihood 
    return churn_competing_ll(log_h, Hc, cause);
}

//@laplace
//@brief Churn Competing Gompertz Random Number Generation
//@param vector gamma  : Change in log hazard per unit of time for this customer.
//@param vector eta    : Log hazard at t = 0.
//@return vector Simulator draws one latent time per cause
//@math
// T_c = \frac{1}{\gamma_c}\log\left(1 + \gamma_c E_c e^{-\eta_c}\right),\ E_c \sim \mathrm{Exponential}(1) \quad (T_c = \infty \text{ when } 1 + \gamma_c E_c e^{-\eta_c} \le 0) \\
// T = \min_c T_c, \quad \text{cause} = \arg\min_c T_c \quad (\text{returns } (\infty, 0) \text{ if all } T_c = \infty)
vector churn_competing_gompertz_rng(vector gamma, vector eta){
    int C = num_elements(gamma);
    vector[C] Ec;
    vector[C] Tc;
    vector[2] T;
    
    for(c in 1:C){
        Ec[c] = exponential_rng(1);
        
        if(0 >= 1 + gamma[c] * Ec[c] * exp(-eta[c])){
            Tc[c] = positive_infinity();
        }else{
            Tc[c] = (1 / gamma[c]) * log(1 + gamma[c] * Ec[c] * exp(-eta[c]));
        }
    }
    return Tc;
}

//@laplace
//@brief Churn Competing Gompertz Cumulative Incidence Function (CIF)
//@param real u         : Current tenure (u >= 0).
//@param vector gamma   : Change in log hazard per unit of time for this customer.
//@param vector eta     : Log hazard at t = 0.
//@param data vector xq : Quadrature nodes
//@param data vector wd : Quadrature weights
//@return vector Competing Gompertz Cumulative Incidence Function (CIF)
//@math
// \eta'_c = \eta_c + \gamma_c u \quad \text{(shift identity)} \\
// F_c(s \mid u) \approx \sum_{i} w_i \exp\left(\eta'_c + \gamma_c x_i - \sum_{j=1}^{C} e^{\eta'_j}\,\frac{e^{\gamma_j x_i} - 1}{\gamma_j}\right)
vector churn_competing_gompertz_cif(real u, vector gamma, vector eta, data vector xq, data vector wq){
    int C = num_elements(eta);
    int N = num_elements(wq);

    vector[C] eta_der = eta + gamma * u;
    matrix[N, C] H;
    matrix[N, C] log_h_q;
    matrix[N, C] dH_q;

    // Calculate the Competing Cumulative Hazard and Log Hazard Function from Gompertz 
    for(n in 1:N){
        for(c in 1:C){
            H[n, c]        = survival::srv_gompertz_cumulative_hazard(xq[n], gamma[c], eta_der[c]);
            log_h_q[n, c]  = survival::srv_gompertz_log_hazard(xq[n], gamma[c], eta_der[c]); 
            dH_q[n, c]     = log_h_q[n, c] - H[n, c];
        }
    }
    // Return Cumulative Incidence Function (CIF)
    return churn_competing_cif(log_h_q, dH_q, wq);
}

// Competing Risk Makeham ------------------------------------------------------------------------------------------------------------------------------
//@laplace
//@brief Churn Competing Makeham Log Pointwise Density Function 
//@param vector t          : Time since origin t > 0.
//@param vector a          : Constant background hazard (a >= 0).
//@param vector gamma      : Change in log hazard.
//@param matrix[n, c] eta  : Log hazard at t = 0.
//@param data array int cause  : Cause that ended the subscription; 0 = active
//@return real Competing Makeham Log Pointwise Density Function  
//@math
// \log h_c(t_n) = \log\left(a_c + e^{\eta_{nc} + \gamma_c t_n}\right), \quad H_c(t_n) = a_c t_n + e^{\eta_{nc}}\,\frac{e^{\gamma_c t_n} - 1}{\gamma_c} \\
// \log L = \sum_{n=1}^{N} \left\{ \mathbb{1}\{c_n > 0\}\,\log h_{c_n}(t_n) - \sum_{c=1}^{C} H_c(t_n) \right\}
real churn_competing_makeham_lpdf(vector t, vector a, vector gamma, matrix eta, data array[] int cause){
    int N = rows(eta);
    int C = cols(eta);

    matrix[N, C] H;
    matrix[N, C] log_Hc;
    // Calculate the Competing Cumulative Hazard and Log Hazard Function from Makeham 
    for(n in 1:N){
        for(c in 1:C){
            H[n, c]      = survival::srv_makeham_cumulative_hazard(t[n], a[c], gamma[c], eta[n,c]);
            log_Hc[n, c] = survival::srv_makeham_log_hazard(t[n], a[c], gamma[c], eta[n,c]); 
        }
    }
    // Return Competing Makeham lpdf
    return churn_competing_ll(log_Hc, H, cause);
}
real churn_competing_makeham_lpdf(vector t, matrix a, vector gamma, matrix eta, data array[] int cause){
    int N = rows(eta);
    int C = cols(eta);

    matrix[N, C] H;
    matrix[N, C] log_Hc;
    // Calculate the Competing Cumulative Hazard and Log Hazard Function from Makeham 
    for(n in 1:N){
        for(c in 1:C){
            H[n, c]      = survival::srv_makeham_cumulative_hazard(t[n], a[n, c], gamma[c], eta[n,c]);
            log_Hc[n, c] = survival::srv_makeham_log_hazard(t[n], a[n ,c], gamma[c], eta[n,c]); 
        }
    }
    // Return Competing Makeham lpdf
    return churn_competing_ll(log_Hc, H, cause);
}

//@laplace 
//@brief Churn Competing Makeham Random Number Generator 
//@param vector a          : Constant background hazard (a >= 0).
//@param vector gamma      : Change in log hazard.
//@param vector eta        : Log hazard at t = 0.
//@return vector Churn Random Number from Makeham 
//@math
// T_{a,c} \sim \mathrm{Exponential}(a_c), \quad T_{G,c} = \frac{1}{\gamma_c}\log\left(1 + \gamma_c E_c e^{-\eta_c}\right),\ E_c \sim \mathrm{Exponential}(1) \\
// T_c = \min(T_{a,c}, T_{G,c}), \quad T = \min_c T_c, \quad \text{cause} = \arg\min_c T_c
vector churn_competing_makeham_rng(vector a, vector gamma, vector eta){
    int N = num_elements(a);
    int C = num_elements(eta);

    matrix[N, C] Tca;
    matrix[N, C] Tg;
    vector[C] Tc;

    for(n in 1:N){
        for(c in 1:C){
            Tca[n, c] = exponential_rng(a[c]);
            Tg[n, c]  = survival::srv_gompertz_rng(gamma[c], eta[c]);
            Tc[c]     = Tca[n, c] > Tg[n, c] ? Tg[n, c] : Tca[n, c]; 
        }
    }
    return Tc;
}

//@laplace
//@brief Churn Competing Makeham Cumulative Incidence Function (CIF)
//@param real u         : Current tenure (u >= 0).
//@param vector a       : Constant background hazard (a >= 0).
//@param vector gamma   : Change in log hazard per unit of time for this customer.
//@param vector eta     : Log hazard at t = 0.
//@param data vector xq : Quadrature nodes
//@param data vector wd : Quadrature weights
//@return vector Competing Makeham Cumulative Incidence Function (CIF)
//@math
// \eta'_c = \eta_c + \gamma_c u \\
// F_c(s \mid u) \approx \sum_{i} w_i \left(a_c + e^{\eta'_c + \gamma_c x_i}\right) \exp\left(-\sum_{j=1}^{C}\left[a_j x_i + e^{\eta'_j}\,\frac{e^{\gamma_j x_i} - 1}{\gamma_j}\right]\right)
vector churn_competing_makeham_cif(real u, vector a, vector gamma, vector eta, data vector xq, data vector wq){
    int C = num_elements(a);
    int N = num_elements(wq);

    vector[C] eta_der = eta + gamma * u;
    matrix[N, C] H;
    matrix[N, C] log_h_q;
    matrix[N, C] dH_q;

    // Calculate the Competing Cumulative Hazard and Log Hazard Function from Makeham 
    for(n in 1:N){
        for(c in 1:C){
            H[n, c]        = survival::srv_makeham_cumulative_hazard(xq[n], a[c], gamma[c], eta_der[c]);
            log_h_q[n, c]  = survival::srv_makeham_log_hazard(xq[n], a[c], gamma[c], eta_der[c]); 
            dH_q[n, c]     = log_h_q[n, c] - H[n, c];
        }
    }
    // Return Cumulative Incidence Function (CIF)
    return churn_competing_cif(log_h_q, dH_q, wq);
}

// Latent churn segments (via cluster) =======================================================================================================================================================
/*
Build the N × K matrix of per-segment survival log likelihoods so that cluster’s mixture
machinery can fit K unobserved customer types with different churn curves
*/

// Generic core ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
//@laplace
//@brief Build matrix of per-segment log likelihoods.
//@param matrix[n, k] log_h : Log Hazard Function for k cluster
//@param matrix H[, k] H    : Cumulative Hazard Function for k cluster
//@param data vector d      : Event Indicator 
//@return matrix L of per-segment log likelihood
//@math
// L_{nk} = d_n \log h_k(t_n) - H_k(t_n) \\
// \log L = \sum_{n=1}^{N} \log\sum_{k=1}^{K} \exp\left(\log\theta_{nk} + L_{nk}\right) \quad \text{(via cluster::mixture\_lpdf)}
matrix churn_segment_L(matrix log_h, matrix H, data vector d){
    int N = rows(log_h);
    int K = cols(log_h);

    matrix[N, K] L;

    for(n in 1:N){
        for(k in 1:K){
            L[n, k] = d[n] * log_h[n,k] - H[n, k];
        }
    }
    return L;
}

// Gompertz Family -----------------------------------------------------------------------------------------------------------------------------
//@laplace 
//@brief Churn Segment Gompertz L Builder
//@param vector t     : Time since origin t > 0.
//@param vector gamma : Change in log hazard.
//@param vector eta[n, k]   : Log hazard at t = 0 per cluster k
//@return matrix Segment Gompertz L to be used with cluster library 
//@math
// \log h_k(t_n) = \eta_{nk} + \gamma_k t_n, \quad H_k(t_n) = e^{\eta_{nk}}\,\frac{e^{\gamma_k t_n} - 1}{\gamma_k} \\
// L_{nk} = d_n\left(\eta_{nk} + \gamma_k t_n\right) - e^{\eta_{nk}}\,\frac{e^{\gamma_k t_n} - 1}{\gamma_k}
matrix churn_segment_gompertz_L(vector t, data vector d, vector gamma, matrix eta){
    int N = rows(eta);
    int K = cols(eta);

    matrix[N, K] log_h;
    matrix[N, K] H;

    for(n in 1:N){
        for(k in 1:K){
            log_h[n, k] = survival::srv_gompertz_log_hazard(t[n], gamma[k], eta[n, k]);
            H[n, k]     = survival::srv_gompertz_cumulative_hazard(t[n], gamma[k], eta[n, k]);
        }
    }
    return churn_segment_L(log_h, H, d);
}
matrix churn_segment_gompertz_L(vector t, data vector d, matrix gamma, matrix eta){
    int N = rows(eta);
    int K = cols(eta);

    matrix[N, K] log_h;
    matrix[N, K] H;

    for(n in 1:N){
        for(k in 1:K){
            log_h[n, k] = survival::srv_gompertz_log_hazard(t[n], gamma[n ,k], eta[n, k]);
            H[n, k]     = survival::srv_gompertz_cumulative_hazard(t[n], gamma[n, k], eta[n, k]);
        }
    }
    return churn_segment_L(log_h, H, d);
}

// Makeham Family --------------------------------------------------------------------------------------------------------------------------------------
//@laplace 
//@brief Churn Segment Makeham L Builder
//@param vector t          : Time since origin t > 0.
//@param vector a          : Constant background hazard (a >= 0).
//@param vector gamma      : Change in log hazard per unit of time.
//@param matrix eta[n, k]  : Log hazard at t = 0 per cluster k.
//@return matrix Segment Makeham L, to be used with cluster library
//@math
// \log h_k(t_n) = \log\left(a_k + e^{\eta_{nk} + \gamma_k t_n}\right), \quad H_k(t_n) = a_k t_n + e^{\eta_{nk}}\,\frac{e^{\gamma_k t_n} - 1}{\gamma_k} \\
// L_{nk} = d_n \log h_k(t_n) - H_k(t_n)
matrix churn_segment_makeham_L(vector t, data vector d, vector a, vector gamma, matrix eta){
    int N = rows(eta);
    int K = cols(eta);

    matrix[N, K] log_h;
    matrix[N, K] H;

    for(n in 1:N){
        for(k in 1:K){
            H[n, k]     = survival::srv_makeham_cumulative_hazard(t[n], a[k], gamma[k], eta[n, k]);
            log_h[n, k] = survival::srv_makeham_log_hazard(t[n], a[k], gamma[k], eta[n, k]); 
        }
    }
    return churn_segment_L(log_h, H, d);
}
matrix churn_segment_makeham_L(vector t, data vector d, matrix a, vector gamma, matrix eta){
    int N = rows(eta);
    int K = cols(eta);

    matrix[N, K] log_h;
    matrix[N, K] H;

    for(n in 1:N){
        for(k in 1:K){
            H[n, k]     = survival::srv_makeham_cumulative_hazard(t[n], a[n, k], gamma[k], eta[n, k]);
            log_h[n, k] = survival::srv_makeham_log_hazard(t[n], a[n, k], gamma[k], eta[n, k]); 
        }
    }
    return churn_segment_L(log_h, H, d);
}
matrix churn_segment_makeham_L(vector t, data vector d, vector a, matrix gamma, matrix eta){
    int N = rows(eta);
    int K = cols(eta);

    matrix[N, K] log_h;
    matrix[N, K] H;

    for(n in 1:N){
        for(k in 1:K){
            H[n, k]     = survival::srv_makeham_cumulative_hazard(t[n], a[k], gamma[n, k], eta[n, k]);
            log_h[n, k] = survival::srv_makeham_log_hazard(t[n], a[k], gamma[n, k], eta[n, k]); 
        }
    }
    return churn_segment_L(log_h, H, d);
}
matrix churn_segment_makeham_L(vector t, data vector d, matrix a, matrix gamma, matrix eta){
    int N = rows(eta);
    int K = cols(eta);

    matrix[N, K] log_h;
    matrix[N, K] H;

    for(n in 1:N){
        for(k in 1:K){
            H[n, k]     = survival::srv_makeham_cumulative_hazard(t[n], a[n, k], gamma[n, k], eta[n, k]);
            log_h[n, k] = survival::srv_makeham_log_hazard(t[n], a[n, k], gamma[n, k], eta[n, k]); 
        }
    }
    return churn_segment_L(log_h, H, d);
}

// Derived quantities -----------------------------------------------------------------------------------------------------------------------
//@laplace 
//@brief Churn Segment Conditional survival
//@param matrix R  : Pr(segment | k  tn, dn) or is the responsibility; each row sums to 1
//@param matrix dH : Delta Cumulative Hazard Function H(un + s) - H(un)
//@return vector Probability that an active customer is still subscribed after $s$ more time units.
//@math
// \text{Existing customers: } S_n(u_n + s \mid u_n, \text{data}) = \sum_{k=1}^{K} r_{nk}\,\exp\left(-\left[H_k(u_n + s) - H_k(u_n)\right]\right) \\
// r_{nk} = \exp\left(\log\theta_{nk} + L_{nk} - \log\sum_{j=1}^{K}\exp\left(\log\theta_{nj} + L_{nj}\right)\right) \\
// \text{Population / new customer: } S(u + s \mid u) = \frac{\sum_{k} \theta_k\, e^{-H_k(u + s)}}{\sum_{k} \theta_k\, e^{-H_k(u)}}
vector churn_segment_cond_surv(matrix R, matrix dH){
    int N = rows(R);
    int K = cols(R);

    vector[N] sn;

    for(n in 1:N){
        sn[n] = 0;
        for(k in 1:K){
            sn += R[n, k] * exp(-dH[n, k]);
        }
    }
    return sn;
}
